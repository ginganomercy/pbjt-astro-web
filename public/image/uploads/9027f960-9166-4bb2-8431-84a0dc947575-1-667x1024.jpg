uan-suara" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm flex items-center gap-2" data-astro-cid-j7pv25f6><img src="/image/logo-ukm/logo-padus.png" class="w-6 h-6 object-contain" onerror="this.src='/image/logo-ukm/logo-polbaja.png'" data-astro-cid-j7pv25f6> PADUAN SUARA</a> <a href="/forum-studi-ilmiah-fosil" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm flex items-center gap-2" data-astro-cid-j7pv25f6><img src="/image/logo-ukm/logo-fosil.png" class="w-6 h-6 object-contain" onerror="this.src='/image/logo-ukm/logo-polbaja.png'" data-astro-cid-j7pv25f6> FOSIL</a> </div> </div> </section> <!-- CTA PMB Section --> <section class="py-24 bg-slate-900 relative overflow-hidden" data-astro-cid-j7pv25f6> <!-- Decorative Glow --> <div class="absolute top-0 right-0 w-96 h-96 bg-primary-light/10 rounded-full blur-[80px] pointer-events-none translate-x-1/2 -translate-y-1/2" data-astro-cid-j7pv25f6></div> <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary/10 rounded-full blur-[80px] pointer-events-none -translate-x-1/2 translate-y-1/2" data-astro-cid-j7pv25f6></div> <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5" data-astro-cid-j7pv25f6></div> <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10" data-astro-cid-j7pv25f6> <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6 leading-tight" data-astro-cid-j7pv25f6>
