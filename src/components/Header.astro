---
import { navLinks } from '../data/navigation.js';
---

<!-- Top Announcement Ticker -->
<div class="bg-primary-dark text-secondary-light text-sm md:text-base font-semibold py-2 md:py-3 overflow-hidden whitespace-nowrap relative z-[60] border-b border-primary/20">
    <div class="ticker-animate">
        <span class="inline-flex items-center gap-2 md:gap-3 px-4">
            <span class="flex h-2 w-2 md:h-3 md:w-3 rounded-full bg-secondary animate-pulse shadow-[0_0_10px_rgba(245,158,11,1)]"></span>
            Pengumuman: Penerimaan Mahasiswa Baru Tahun Ajaran 2026/2027 Telah Resmi Dibuka! Segera Daftarkan Dirimu, Gelombang Pertama Ditutup Bulan Ini!
        </span>
    </div>
</div>

<!-- Main Navbar -->
<nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-slate-100 shadow-sm relative">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-16 md:h-20">
            <!-- Brand Logo -->
            <a href="/" class="flex items-center gap-2 md:gap-3 group z-50">
                <img src="/logo-pbjt-s.png" alt="Logo PBJT" class="h-8 md:h-10 w-auto group-hover:scale-105 transition-transform" />
                <span class="font-bold text-lg md:text-xl text-primary-dark tracking-tight">Politeknik Baja Tegal</span>
            </a>

            <!-- Desktop Menu (Declarative from navLinks) -->
            <div class="hidden lg:flex space-x-6 font-medium text-slate-600 items-center">
                <a href="/" class="hover:text-primary transition-colors">Beranda</a>
                
                <!-- Dropdown Profil -->
                <div class="relative group">
                    <button class="hover:text-primary transition-colors flex items-center gap-1">
                        Profil <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    <div class="absolute left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                        <div class="py-2 flex flex-col">
                            {navLinks.profil.map((item) => (
                                <a href={item.href} class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm transition-colors">
                                    {item.title}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>

                <!-- Dropdown Akademik -->
                <div class="relative group">
                    <button class="hover:text-primary transition-colors flex items-center gap-1">
                        Akademik <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    <div class="absolute left-0 mt-2 w-60 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                        <div class="py-2 flex flex-col">
                            <!-- Nested Group untuk Program Studi -->
                            <div class="relative group/sub">
                                <a href="/program-studi" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm flex justify-between items-center w-full">
                                    Program Studi
                                    <svg class="w-4 h-4 -rotate-90 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </a>
                                <!-- Submenu Program Studi -->
                                <div class="absolute left-full top-0 ml-1 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover/sub:opacity-100 group-hover/sub:visible transition-all duration-300 z-50">
                                    <div class="py-2 flex flex-col">
                                        {navLinks.prodi.map((p) => (
                                            <div class="relative group/lvl3">
                                                <a href={p.href} class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm flex justify-between items-center w-full">
                                                    {p.shortName} <svg class="w-4 h-4 -rotate-90 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                                </a>
                                                <div class="absolute left-full top-0 ml-1 w-48 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover/lvl3:opacity-100 group-hover/lvl3:visible transition-all duration-300 z-50">
                                                    <div class="py-2 flex flex-col">
                                                        <a href={p.rps} class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">RPS</a>
                                                        <a href={p.modul} class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Modul</a>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                            <a href="/mikrotik-academy" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Mikrotik Academy</a>
                        </div>
                    </div>
                </div>
                
                <!-- Dropdown Kemahasiswaan -->
                <div class="relative group">
                    <button class="hover:text-primary transition-colors flex items-center gap-1">
                        Kemahasiswaan <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    <div class="absolute left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                        <div class="py-2 flex flex-col">
                            {navLinks.kemahasiswaan.map((ukm) => (
                                <a href={ukm.href} class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm flex items-center gap-3">
                                    <img 
                                        src={ukm.logo} 
                                        alt={ukm.name} 
                                        class="w-5 h-5 object-contain" 
                                        onerror={ukm.fallbackLogo ? `this.onerror=null; this.src='${ukm.fallbackLogo}';` : "this.onerror=null; this.src='/image/logo-ukm/logo-polbaja.png';"} 
                                    />
                                    <span>{ukm.name}</span>
                                </a>
                            ))}
                            <div class="border-t border-slate-100 my-1"></div>
                            <a href="/kegiatan-ukm" class="px-4 py-2 hover:bg-blue-50 text-blue-600 hover:text-blue-700 text-sm font-semibold flex items-center justify-between group/link">
                                Berita Kegiatan UKM
                                <svg class="w-4 h-4 transform group-hover/link:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                </svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- Dropdown PMB -->
                <div class="relative group">
                    <button class="hover:text-primary transition-colors flex items-center gap-1">
                        PMB <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                    <div class="absolute left-0 mt-2 w-52 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                        <div class="py-2 flex flex-col">
                            {navLinks.pmb.map((item) => (
                                <a href={item.href} class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm transition-colors">
                                    {item.title}
                                </a>
                            ))}
                        </div>
                    </div>
                </div>

                <!-- External Quick Portals -->
                {navLinks.external.map((ext) => (
                    <a href={ext.href} target="_blank" rel="noopener noreferrer" class="text-xs px-3 py-1.5 bg-primary/10 text-primary rounded-lg hover:bg-primary hover:text-white transition-all font-semibold">
                        {ext.title} ↗
                    </a>
                ))}
            </div>

            <!-- Mobile Hamburger Toggle -->
            <button id="mobile-menu-btn" aria-label="Toggle Menu" class="lg:hidden p-2 text-slate-600 hover:text-primary transition-colors z-50 focus:outline-none">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                </svg>
            </button>
        </div>
    </div>
</nav>

<!-- Mobile Menu Drawer (Declarative mapping) -->
<div id="mobile-menu" class="fixed inset-0 bg-white z-40 transform translate-x-full transition-transform duration-300 lg:hidden overflow-y-auto pt-32 pb-6 px-6">
    <div class="flex flex-col space-y-4">
        <a href="/" class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-2">Beranda</a>
        
        <!-- Mobile Profil -->
        <details class="group">
            <summary class="flex justify-between items-center text-lg font-bold text-slate-800 border-b border-slate-100 pb-2 cursor-pointer list-none">
                Profil <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="flex flex-col pl-4 pt-2 space-y-3">
                {navLinks.profil.map((item) => (
                    <a href={item.href} class="text-slate-600 text-sm hover:text-primary">{item.title}</a>
                ))}
            </div>
        </details>

        <!-- Mobile Akademik -->
        <details class="group">
            <summary class="flex justify-between items-center text-lg font-bold text-slate-800 border-b border-slate-100 pb-2 cursor-pointer list-none">
                Akademik <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="flex flex-col pl-4 pt-2 space-y-3">
                <details class="group/sub">
                    <summary class="flex justify-between items-center text-slate-600 text-sm cursor-pointer list-none">
                        Program Studi
                        <svg class="w-4 h-4 transform group-open/sub:rotate-180 transition-transform text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </summary>
                    <div class="flex flex-col pl-4 pt-2 space-y-3 border-l-2 border-slate-100 ml-1 mt-2">
                        <a href="/program-studi" class="text-primary text-sm font-semibold">Beranda Program Studi</a>
                        
                        {navLinks.prodi.map((p) => (
                            <details class="group/lvl3">
                                <summary class="flex justify-between items-center text-slate-600 text-sm cursor-pointer list-none">
                                    {p.shortName} <svg class="w-4 h-4 transform group-open/lvl3:rotate-180 transition-transform text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                </summary>
                                <div class="flex flex-col pl-4 pt-2 space-y-2 border-l-2 border-slate-100 ml-1 mt-1">
                                    <a href={p.href} class="text-primary text-xs font-semibold">Beranda Prodi</a>
                                    <a href={p.rps} class="text-slate-500 text-xs hover:text-primary">RPS</a>
                                    <a href={p.modul} class="text-slate-500 text-xs hover:text-primary">Modul</a>
                                </div>
                            </details>
                        ))}
                    </div>
                </details>
                <a href="/mikrotik-academy" class="text-slate-600 text-sm font-semibold text-primary">Mikrotik Academy</a>
            </div>
        </details>
        
        <!-- Mobile Kemahasiswaan -->
        <details class="group">
            <summary class="flex justify-between items-center text-lg font-bold text-slate-800 border-b border-slate-100 pb-2 cursor-pointer list-none">
                Kemahasiswaan <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="flex flex-col pl-4 pt-2 space-y-3">
                {navLinks.kemahasiswaan.map((ukm) => (
                    <a href={ukm.href} class="text-slate-600 text-sm flex items-center gap-3">
                        <img 
                            src={ukm.logo} 
                            alt={ukm.name} 
                            class="w-5 h-5 object-contain" 
                            onerror={ukm.fallbackLogo ? `this.onerror=null; this.src='${ukm.fallbackLogo}';` : "this.onerror=null; this.src='/image/logo-ukm/logo-polbaja.png';"} 
                        />
                        <span>{ukm.name}</span>
                    </a>
                ))}
                <div class="border-t border-slate-100 my-1"></div>
                <a href="/kegiatan-ukm" class="text-blue-600 font-semibold text-sm">Berita Kegiatan UKM →</a>
            </div>
        </details>

        <!-- Mobile PMB -->
        <details class="group">
            <summary class="flex justify-between items-center text-lg font-bold text-slate-800 border-b border-slate-100 pb-2 cursor-pointer list-none">
                PMB <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
            </summary>
            <div class="flex flex-col pl-4 pt-2 space-y-3">
                {navLinks.pmb.map((item) => (
                    <a href={item.href} class="text-slate-600 text-sm hover:text-primary">{item.title}</a>
                ))}
            </div>
        </details>

        <!-- Mobile External Portals -->
        <div class="flex flex-col gap-3 pt-4">
            {navLinks.external.map((ext) => (
                <a href={ext.href} target="_blank" rel="noopener noreferrer" class="text-center px-4 py-3 bg-primary/10 text-primary rounded-xl font-bold hover:bg-primary hover:text-white transition-all">
                    {ext.title} ↗
                </a>
            ))}
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('mobile-menu-btn');
        const menu = document.getElementById('mobile-menu');
        
        if (btn && menu) {
            btn.addEventListener('click', () => {
                const isClosed = menu.classList.contains('translate-x-full');
                if (isClosed) {
                    menu.classList.remove('translate-x-full');
                    document.body.classList.add('menu-open');
                    btn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
                } else {
                    menu.classList.add('translate-x-full');
                    document.body.classList.remove('menu-open');
                    btn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>`;
                }
            });
        }
    });
</script>
