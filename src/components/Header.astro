<!-- Top Announcement Ticker -->
<div class="bg-primary-dark text-secondary-light text-sm md:text-base font-semibold py-2 md:py-3 overflow-hidden whitespace-nowrap relative z-[60] border-b border-primary/20">
    <div class="ticker-animate">
        <span class="inline-flex items-center gap-2 md:gap-3 px-4">
            <span class="flex h-2 w-2 md:h-3 md:w-3 rounded-full bg-secondary animate-pulse shadow-[0_0_10px_rgba(245,158,11,1)]"></span>
            Pengumuman: Penerimaan Mahasiswa Baru Tahun Ajaran 2026/2027 Telah Resmi Dibuka! Segera Daftarkan Dirimu, Gelombang Pertama Ditutup Bulan Ini!
        </span>
    </div>
</div>

<!-- Navbar -->
