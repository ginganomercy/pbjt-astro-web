---
const { title = "Politeknik Baja Tegal" } = Astro.props;
---

<html lang="id" class="overflow-x-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
</head>
<body class="bg-background text-text font-sans selection:bg-secondary selection:text-text overflow-x-hidden flex flex-col min-h-screen">
    <style is:global>
        @keyframes scroll-text {
            0% { transform: translateX(100vw); }
            100% { transform: translateX(-100%); }
        }
        .ticker-animate {
            display: inline-block;
            white-space: nowrap;
            animation: scroll-text 25s linear infinite;
            will-change: transform;
        }
        .ticker-animate:hover {
            animation-play-state: paused;
        }
        /* Style for mobile menu toggle */
        body.menu-open {
            overflow: hidden;
        }
    </style>

    <!-- Top Announcement Ticker -->
    <div class="bg-primary-dark text-secondary-light text-sm md:text-base font-semibold py-2 md:py-3 overflow-hidden whitespace-nowrap relative z-[60] border-b border-primary/20">
        <div class="ticker-animate">
            <span class="inline-flex items-center gap-2 md:gap-3 px-4">
                <span class="flex h-2 w-2 md:h-3 md:w-3 rounded-full bg-secondary animate-pulse shadow-[0_0_10px_rgba(245,158,11,1)]"></span>
                Pengumuman: Penerimaan Mahasiswa Baru Tahun Ajaran 2026/2027 Telah Resmi Dibuka! Segera Daftarkan Dirimu, Gelombang Pertama Ditutup Bulan Ini!
            </span>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-slate-100 shadow-sm relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-16 md:h-20">
                <!-- Logo -->
                <a href="/" class="flex items-center gap-2 md:gap-3 group z-50">
                    <img src="/logo-pbjt-s.png" alt="Logo PBJT" class="h-8 md:h-10 w-auto group-hover:scale-105 transition-transform" />
                    <span class="font-bold text-lg md:text-xl text-primary-dark tracking-tight">Politeknik Baja Tegal</span>
                </a>

                <!-- Desktop Menu -->
                <div class="hidden lg:flex space-x-6 font-medium text-slate-600 items-center">
                    <a href="/" class="hover:text-primary transition-colors">Beranda</a>
                    
                    <!-- Dropdown Profil -->
                    <div class="relative group">
                        <button class="hover:text-primary transition-colors flex items-center gap-1">
                            Profil <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="absolute left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                            <div class="py-2 flex flex-col">
                                <a href="/tentang-pbjt" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Tentang PBJT</a>
                                <a href="/profil-politeknik-baja-tegal" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Profil Kampus</a>
                                <a href="/struktur-politeknik-baja-tegal" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Struktur Organisasi</a>
                                <a href="/biro" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">BIRO (BAAK)</a>
                                <a href="/akreditasi" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Akreditasi</a>
                            </div>
                        </div>
                    </div>

                    <!-- Dropdown Akademik -->
                    <div class="relative group">
                        <button class="hover:text-primary transition-colors flex items-center gap-1">
                            Akademik <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="absolute left-0 mt-2 w-60 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                            <div class="py-2 flex flex-col">
                                <a href="/program-studi" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Program Studi</a>
                                <a href="/d3-teknik-informatika" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">D3 Teknik Informatika</a>
                                <a href="/d3-teknik-mesin" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">D3 Teknik Mesin</a>
                                <a href="/d3-teknik-otomotif" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">D3 Teknik Otomotif</a>
                                <a href="/d3-teknik-elektronika-industri" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">D3 Teknik Elektronika</a>
                                <a href="/mikrotik-academy" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Mikrotik Academy</a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Dropdown Kemahasiswaan -->
                    <div class="relative group">
                        <button class="hover:text-primary transition-colors flex items-center gap-1">
                            Kemahasiswaan <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="absolute left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                            <div class="py-2 flex flex-col">
                                <a href="/bem" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">BEM</a>
                                <a href="/hmti" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">HMTI</a>
                                <a href="/rohis" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">ROHIS</a>
                                <a href="/racana" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">RACANA</a>
                                <a href="/bajapala" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">BAJAPALA</a>
                                <a href="/badminton" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">BADMINTON</a>
                                <a href="/futsal" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">FUTSAL</a>
                                <a href="/paduan-suara" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">PADUAN SUARA</a>
                                <a href="/forum-studi-ilmiah-fosil" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">FOSIL</a>
                            </div>
                        </div>
                    </div>

                    <!-- Dropdown PMB -->
                    <div class="relative group">
                        <button class="hover:text-primary transition-colors flex items-center gap-1">
                            PMB <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="absolute left-0 mt-2 w-52 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                            <div class="py-2 flex flex-col">
                                <a href="/pmb" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Info PMB</a>
                                <a href="/alur-pendaftaran" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Alur Pendaftaran</a>
                                <a href="/biaya-perkuliahan" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Biaya Perkuliahan</a>
                                <a href="/beasiswa-kip-kuliah" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Beasiswa KIP Kuliah</a>
                            </div>
                        </div>
                    </div>

                    <!-- Link Eksternal -->
                    <a href="https://siakad.pbjt.ac.id" target="_blank" rel="noopener" class="text-xs px-3 py-1.5 bg-primary/10 text-primary rounded-lg hover:bg-primary hover:text-white transition-all">Siakad ↗</a>
                    <a href="https://edlink.id/login" target="_blank" rel="noopener" class="text-xs px-3 py-1.5 bg-primary/10 text-primary rounded-lg hover:bg-primary hover:text-white transition-all">E-Learning ↗</a>
                </div>

                <!-- Mobile Hamburger Button -->
                <button id="mobile-menu-btn" aria-label="Toggle Menu" class="lg:hidden p-2 text-slate-600 hover:text-primary transition-colors z-50 focus:outline-none">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Mobile Menu Overlay -->
        <div id="mobile-menu" class="fixed inset-0 bg-white z-40 transform translate-x-full transition-transform duration-300 lg:hidden overflow-y-auto pt-20 pb-6 px-6">
            <div class="flex flex-col space-y-4">
                <a href="/" class="text-lg font-bold text-slate-800 border-b border-slate-100 pb-2">Beranda</a>
                
                <details class="group">
                    <summary class="flex justify-between items-center text-lg font-bold text-slate-800 border-b border-slate-100 pb-2 cursor-pointer list-none">
                        Profil <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </summary>
                    <div class="flex flex-col pl-4 pt-2 space-y-3">
                        <a href="/tentang-pbjt" class="text-slate-600 text-sm">Tentang PBJT</a>
                        <a href="/profil-politeknik-baja-tegal" class="text-slate-600 text-sm">Profil Kampus</a>
                        <a href="/struktur-politeknik-baja-tegal" class="text-slate-600 text-sm">Struktur Organisasi</a>
                        <a href="/biro" class="text-slate-600 text-sm">BIRO (BAAK)</a>
                        <a href="/akreditasi" class="text-slate-600 text-sm">Akreditasi</a>
                    </div>
                </details>

                <details class="group">
                    <summary class="flex justify-between items-center text-lg font-bold text-slate-800 border-b border-slate-100 pb-2 cursor-pointer list-none">
                        Akademik <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </summary>
                    <div class="flex flex-col pl-4 pt-2 space-y-3">
                        <a href="/program-studi" class="text-slate-600 text-sm">Program Studi</a>
                        <a href="/d3-teknik-informatika" class="text-slate-600 text-sm">D3 Teknik Informatika</a>
                        <a href="/d3-teknik-mesin" class="text-slate-600 text-sm">D3 Teknik Mesin</a>
                        <a href="/d3-teknik-otomotif" class="text-slate-600 text-sm">D3 Teknik Otomotif</a>
                        <a href="/d3-teknik-elektronika-industri" class="text-slate-600 text-sm">D3 Teknik Elektronika</a>
                        <a href="/mikrotik-academy" class="text-slate-600 text-sm font-semibold text-primary">Mikrotik Academy</a>
                    </div>
                </details>
                
                <details class="group">
                    <summary class="flex justify-between items-center text-lg font-bold text-slate-800 border-b border-slate-100 pb-2 cursor-pointer list-none">
                        Kemahasiswaan <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </summary>
                    <div class="flex flex-col pl-4 pt-2 space-y-3">
                        <a href="/bem" class="text-slate-600 text-sm">BEM</a>
                        <a href="/hmti" class="text-slate-600 text-sm">HMTI</a>
                        <a href="/rohis" class="text-slate-600 text-sm">ROHIS</a>
                        <a href="/racana" class="text-slate-600 text-sm">RACANA</a>
                        <a href="/bajapala" class="text-slate-600 text-sm">BAJAPALA</a>
                        <a href="/badminton" class="text-slate-600 text-sm">BADMINTON</a>
                        <a href="/futsal" class="text-slate-600 text-sm">FUTSAL</a>
                        <a href="/paduan-suara" class="text-slate-600 text-sm">PADUAN SUARA</a>
                        <a href="/forum-studi-ilmiah-fosil" class="text-slate-600 text-sm">FOSIL</a>
                    </div>
                </details>

                <details class="group">
                    <summary class="flex justify-between items-center text-lg font-bold text-slate-800 border-b border-slate-100 pb-2 cursor-pointer list-none">
                        PMB <svg class="w-4 h-4 transform group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </summary>
                    <div class="flex flex-col pl-4 pt-2 space-y-3">
                        <a href="/pmb" class="text-slate-600 text-sm">Info PMB</a>
                        <a href="/alur-pendaftaran" class="text-slate-600 text-sm">Alur Pendaftaran</a>
                        <a href="/biaya-perkuliahan" class="text-slate-600 text-sm">Biaya Perkuliahan</a>
                        <a href="/beasiswa-kip-kuliah" class="text-slate-600 text-sm">Beasiswa KIP Kuliah</a>
                    </div>
                </details>

                <div class="flex flex-col gap-3 pt-4">
                    <a href="https://siakad.pbjt.ac.id" target="_blank" rel="noopener" class="text-center px-4 py-3 bg-primary/10 text-primary rounded-xl font-bold hover:bg-primary hover:text-white transition-all">Siakad ↗</a>
                    <a href="https://edlink.id/login" target="_blank" rel="noopener" class="text-center px-4 py-3 bg-primary/10 text-primary rounded-xl font-bold hover:bg-primary hover:text-white transition-all">E-Learning ↗</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- MAIN CONTENT INJECTION POINT -->
    <slot />

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-12 md:py-16 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 md:gap-12">
                <!-- Col 1 -->
                <div>
                    <div class="flex items-center gap-3 mb-6">
                        <img src="/logo-pbjt-s.png" alt="Logo PBJT" class="h-10 md:h-12 w-auto bg-white/10 p-1 rounded-lg" />
                        <span class="text-lg md:text-xl font-bold text-white leading-tight">Politeknik Baja Tegal</span>
                    </div>
                    <p class="text-sm text-slate-400 mb-6 leading-relaxed">
                        Kampus vokasi modern yang mencetak SDM unggul, profesional, dan berdaya saing global di era industri digital.
                    </p>
                    <div class="text-sm">
                        <p class="mb-2"><strong class="text-slate-300">📍 Alamat:</strong><br/>Jl. Raya Tegal-Slawi, Jawa Tengah</p>
                    </div>
                </div>

                <!-- Col 2 -->
                <div>
                    <h3 class="text-white font-bold mb-4 md:mb-6 uppercase tracking-wider text-sm">Profil & Akademik</h3>
                    <ul class="space-y-3 text-sm">
                        <li><a href="/tentang-pbjt" class="hover:text-primary transition-colors">Tentang PBJT</a></li>
                        <li><a href="/profil-politeknik-baja-tegal" class="hover:text-primary transition-colors">Profil Kampus</a></li>
                        <li><a href="/struktur-politeknik-baja-tegal" class="hover:text-primary transition-colors">Struktur Organisasi</a></li>
                        <li><a href="/program-studi" class="hover:text-primary transition-colors">Program Studi</a></li>
                        <li><a href="/akreditasi" class="hover:text-primary transition-colors">Akreditasi</a></li>
                    </ul>
                </div>

                <!-- Col 3 -->
                <div>
                    <h3 class="text-white font-bold mb-4 md:mb-6 uppercase tracking-wider text-sm">Kemahasiswaan & PMB</h3>
                    <ul class="space-y-3 text-sm">
                        <li><a href="/pmb" class="hover:text-primary transition-colors">Info Pendaftaran</a></li>
                        <li><a href="/biaya-perkuliahan" class="hover:text-primary transition-colors">Biaya Perkuliahan</a></li>
                        <li><a href="/beasiswa-kip-kuliah" class="hover:text-primary transition-colors">Beasiswa KIP Kuliah</a></li>
                        <li><a href="/bem" class="hover:text-primary transition-colors">Unit Kegiatan Mahasiswa</a></li>
                        <li><a href="/magang" class="hover:text-primary transition-colors">Info Magang</a></li>
                    </ul>
                </div>

                <!-- Col 4 -->
                <div>
                    <h3 class="text-white font-bold mb-4 md:mb-6 uppercase tracking-wider text-sm">Tautan Eksternal</h3>
                    <ul class="space-y-3 text-sm">
                        <li><a href="https://siakad.pbjt.ac.id" target="_blank" rel="noopener" class="hover:text-primary transition-colors flex items-center gap-1">Sistem Informasi Akademik ↗</a></li>
                        <li><a href="https://edlink.id/login" target="_blank" rel="noopener" class="hover:text-primary transition-colors flex items-center gap-1">E-Learning (Edlink) ↗</a></li>
                        <li><a href="/berita" class="hover:text-primary transition-colors">Berita & Pengumuman</a></li>
                    </ul>
                </div>
            </div>
            
            <div class="mt-12 md:mt-16 pt-8 border-t border-slate-800 flex flex-col md:flex-row justify-between items-center gap-4 text-xs md:text-sm text-center md:text-left">
                <p>© 2026 Politeknik Baja Tegal. Hak Cipta Dilindungi.</p>
                <p>Powered by Headless WordPress & Astro</p>
            </div>
        </div>
    </footer>

    <!-- Mobile Menu Script -->
    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const btn = document.getElementById('mobile-menu-btn');
            const menu = document.getElementById('mobile-menu');
            
            if (btn && menu) {
                btn.addEventListener('click', () => {
                    const isClosed = menu.classList.contains('translate-x-full');
                    if (isClosed) {
                        menu.classList.remove('translate-x-full');
                        document.body.classList.add('menu-open');
                        btn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>`;
                    } else {
                        menu.classList.add('translate-x-full');
                        document.body.classList.remove('menu-open');
                        btn.innerHTML = `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path></svg>`;
                    }
                });
            }
        });
    </script>
</body>
</html>
