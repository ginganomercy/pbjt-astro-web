---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
const { title = "Politeknik Baja Tegal" } = Astro.props;
---

<html lang="id" class="overflow-x-hidden">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/logo-pbjt-s.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <title>{title}</title>
</head>
<body class="bg-background text-text font-sans selection:bg-secondary selection:text-text overflow-x-hidden flex flex-col min-h-screen">
    <style is:global>
        @keyframes scroll-text {
            0% { transform: translateX(100vw); }
            100% { transform: translateX(-100%); }
        }
        .ticker-animate {
            display: inline-block;
            white-space: nowrap;
            animation: scroll-text 25s linear infinite;
            will-change: transform;
        }
        .ticker-animate:hover {
            animation-play-state: paused;
        }
        /* Style for mobile menu toggle */
        body.menu-open {
            overflow: hidden;
        }
    </style>

    <Header />

    <!-- MAIN CONTENT INJECTION POINT -->
    <slot />

    <Footer />
</body>
</html>
