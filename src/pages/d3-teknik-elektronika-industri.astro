---
import ProdiLayout from '../layouts/ProdiLayout.astro';
import { getPageBySlug } from '../utils/api.js';
import { parseElektronikaContent } from '../utils/contentParser.js';

// Ambil teks asli dari WordPress berdasarkan slug halaman
const page = await getPageBySlug('d3-teknik-elektronika-industri') || await getPageBySlug('d3-teknik-elektronika');
const title = page?.title?.rendered || "D3 Teknik Elektronika Industri";
const rawContent = page?.content?.rendered || "";

// Ekstrak data kotor menjadi bersih
const { deskripsi, prospek, visi, misi, tujuan, strategi, sasaran, struktur } = parseElektronikaContent(rawContent);

// Gambar sertifikat di-hardcode agar aman
const akreditasiImg = "/image/uploads/akreditasi-elektronika.jpg";
---

<ProdiLayout 
    title={title}
    deskripsi={deskripsi}
    prospek={prospek}
    visi={visi}
    misi={misi}
    tujuan={tujuan}
    strategi={strategi}
    sasaran={sasaran}
    struktur={struktur}
    akreditasiImg={akreditasiImg}
/>
