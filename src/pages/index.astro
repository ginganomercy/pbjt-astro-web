---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Politeknik Baja Tegal - Kampus Vokasi Terapan">

    <!-- Hero Section -->
    <main>
        <section class="relative bg-gradient-to-br from-slate-900 via-blue-950 to-slate-900 overflow-hidden">
            <!-- Glowing Orb Effect -->
            <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-primary-light/20 rounded-full blur-[100px] pointer-events-none"></div>
            
            <!-- Background pattern -->
            <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5"></div>
            
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 relative z-10 flex flex-col items-center text-center">
                <h1 class="text-5xl md:text-7xl font-extrabold text-white tracking-tight mb-6 leading-tight drop-shadow-lg">
                    Bangun Masa Depan Bersama <br/> <span class="text-transparent bg-clip-text bg-gradient-to-r from-secondary-light to-secondary drop-shadow-md">Politeknik Baja Tegal</span>
                </h1>
                
                <p class="mt-6 text-xl md:text-2xl text-slate-300 max-w-3xl mb-12 drop-shadow-md">
                    Mencetak generasi unggul, cerdas, inovatif dan berkarakter, serta siap menghadapi tantangan industri modern di era digital.
                </p>
                
                <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto">
                    <a href="/pmb" class="px-8 py-4 bg-gradient-to-r from-secondary-light to-secondary text-slate-900 font-bold rounded-xl shadow-[0_0_20px_rgba(245,158,11,0.4)] hover:shadow-[0_0_30px_rgba(245,158,11,0.6)] hover:-translate-y-1 transition-all duration-300 text-lg w-full sm:w-auto">
                        Daftar Sekarang
                    </a>
                    <a href="/profil-politeknik-baja-tegal" class="px-8 py-4 bg-white/10 text-white border border-white/20 font-bold rounded-xl hover:bg-white/20 hover:-translate-y-1 transition-all duration-300 backdrop-blur-sm text-lg w-full sm:w-auto">
                        Jelajahi Kampus
                    </a>
                </div>
            </div>
            
            <!-- Decorative wave -->
            <div class="absolute bottom-0 w-full translate-y-1">
                <svg class="fill-background" viewBox="0 0 1440 120" xmlns="http://www.w3.org/2000/svg">
                    <path d="M0,64L80,69.3C160,75,320,85,480,80C640,75,800,53,960,48C1120,43,1280,53,1360,58.7L1440,64L1440,120L1360,120C1280,120,1120,120,960,120C800,120,640,120,480,120C320,120,160,120,80,120L0,120Z"></path>
                </svg>
            </div>
        </section>

        <!-- Berita Terbaru (Client-Side Fetch with Skeleton) -->
        <section class="py-24 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-end mb-12">
                <div>
                    <h2 class="text-sm font-bold text-primary uppercase tracking-wider mb-2">Informasi Kampus</h2>
                    <h3 class="text-3xl md:text-4xl font-bold text-text">Berita & Pengumuman</h3>
                </div>
                <a href="/berita" class="text-primary font-medium hover:text-primary-dark flex items-center gap-1 group">
                    Lihat Semua 
                    <span class="group-hover:translate-x-1 transition-transform">→</span>
                </a>
            </div>

            <!-- Skeleton Container -->
            <div id="news-container" class="grid grid-cols-1 md:grid-cols-3 gap-8">
                <!-- Skeletons will be rendered here initially -->
            </div>
            
            <p id="news-error" class="hidden text-center text-red-500 py-12 bg-red-50 rounded-2xl border border-red-100">Gagal memuat berita. Pastikan koneksi API tidak terblokir.</p>

        </section>

        <!-- Program Studi Section -->
        <section class="py-24 bg-slate-50">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-16">
                    <h2 class="text-sm font-bold text-primary uppercase tracking-wider mb-2">Pendidikan Vokasi</h2>
                    <h3 class="text-3xl md:text-4xl font-bold text-text">Program Studi Unggulan</h3>
                    <p class="mt-4 text-slate-500 max-w-2xl mx-auto">Empat program studi terapan yang dirancang untuk mencetak tenaga profesional siap kerja di bidang industri.</p>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
                    <!-- D3 Teknik Informatika -->
                    <a href="/d3-teknik-informatika" class="group bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-2 transition-all duration-300">
                        <img src="/image/logo-prodi/l-teknik-informatika.webp" alt="Logo D3 Teknik Informatika" class="w-16 h-16 object-contain mb-6 group-hover:scale-110 transition-transform drop-shadow-md" />
                        <h4 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-primary transition-colors">D3 Teknik Informatika</h4>
                        <p class="text-slate-500 text-sm leading-relaxed">Pemrograman, jaringan, dan teknologi informasi untuk era digital.</p>
                        <span class="inline-flex items-center mt-4 text-sm font-semibold text-primary opacity-0 group-hover:opacity-100 transition-opacity">Lihat Detail <span class="ml-1">→</span></span>
                    </a>

                    <!-- D3 Teknik Mesin -->
                    <a href="/d3-teknik-mesin" class="group bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-2 transition-all duration-300">
                        <img src="/image/logo-prodi/l-teknik-mesin.webp" alt="Logo D3 Teknik Mesin" class="w-16 h-16 object-contain mb-6 group-hover:scale-110 transition-transform drop-shadow-md" />
                        <h4 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-primary transition-colors">D3 Teknik Mesin</h4>
                        <p class="text-slate-500 text-sm leading-relaxed">Manufaktur, perancangan mesin, dan teknologi material industri.</p>
                        <span class="inline-flex items-center mt-4 text-sm font-semibold text-primary opacity-0 group-hover:opacity-100 transition-opacity">Lihat Detail <span class="ml-1">→</span></span>
                    </a>

                    <!-- D3 Teknik Otomotif -->
                    <a href="/d3-teknik-otomotif" class="group bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-2 transition-all duration-300">
                        <img src="/image/logo-prodi/l-teknik-otomotif.webp" alt="Logo D3 Teknik Otomotif" class="w-16 h-16 object-contain mb-6 group-hover:scale-110 transition-transform drop-shadow-md" />
                        <h4 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-primary transition-colors">D3 Teknik Otomotif</h4>
                        <p class="text-slate-500 text-sm leading-relaxed">Sistem otomotif modern, perawatan kendaraan, dan teknologi hybrid.</p>
                        <span class="inline-flex items-center mt-4 text-sm font-semibold text-primary opacity-0 group-hover:opacity-100 transition-opacity">Lihat Detail <span class="ml-1">→</span></span>
                    </a>

                    <!-- D3 Teknik Elektronika Industri -->
                    <a href="/d3-teknik-elektronika-industri" class="group bg-white rounded-2xl p-8 shadow-sm border border-slate-100 hover:shadow-xl hover:shadow-primary/10 hover:-translate-y-2 transition-all duration-300">
                        <img src="/image/logo-prodi/l-teknik-elektronika.webp" alt="Logo D3 Teknik Elektronika" class="w-16 h-16 object-contain mb-6 group-hover:scale-110 transition-transform drop-shadow-md" />
                        <h4 class="text-lg font-bold text-slate-800 mb-2 group-hover:text-primary transition-colors">D3 Teknik Elektronika</h4>
                        <p class="text-slate-500 text-sm leading-relaxed">Sistem kontrol, otomasi industri, dan elektronika daya.</p>
                        <span class="inline-flex items-center mt-4 text-sm font-semibold text-primary opacity-0 group-hover:opacity-100 transition-opacity">Lihat Detail <span class="ml-1">→</span></span>
                    </a>
                </div>

                <div class="text-center mt-10">
                    <a href="/program-studi" class="inline-flex items-center gap-2 text-primary font-semibold hover:text-primary-dark transition-colors group">
                        Lihat Semua Program Studi <span class="group-hover:translate-x-1 transition-transform">→</span>
                    </a>
                </div>
            </div>
        </section>

        <!-- Kehidupan Kampus / UKM Section -->
        <section class="py-24">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
                <div class="text-center mb-12">
                    <h2 class="text-sm font-bold text-primary uppercase tracking-wider mb-2">Kehidupan Kampus</h2>
                    <h3 class="text-3xl md:text-4xl font-bold text-text">Unit Kegiatan Mahasiswa</h3>
                    <p class="mt-4 text-slate-500 max-w-2xl mx-auto">Kembangkan bakat dan minatmu melalui berbagai organisasi kemahasiswaan.</p>
                </div>

                <div class="flex flex-wrap justify-center gap-3">
                    <a href="/bem" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm">🏛️ BEM</a>
                    <a href="/hmti" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm">💡 HMTI</a>
                    <a href="/rohis" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm">🕌 ROHIS</a>
                    <a href="/racana" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm">⚜️ RACANA</a>
                    <a href="/bajapala" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm">🏔️ BAJAPALA</a>
                    <a href="/badminton" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm">🏸 BADMINTON</a>
                    <a href="/futsal" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm">⚽ FUTSAL</a>
                    <a href="/paduan-suara" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm">🎵 PADUAN SUARA</a>
                    <a href="/forum-studi-ilmiah-fosil" class="px-5 py-3 bg-white border border-slate-200 rounded-xl text-slate-700 font-semibold hover:bg-primary hover:text-white hover:border-primary hover:shadow-lg hover:shadow-primary/20 hover:-translate-y-1 transition-all duration-300 text-sm">🔬 FOSIL</a>
                </div>
            </div>
        </section>

        <!-- CTA PMB Section -->
        <section class="py-24 bg-slate-900 relative overflow-hidden">
            <!-- Decorative Glow -->
            <div class="absolute top-0 right-0 w-96 h-96 bg-primary-light/10 rounded-full blur-[80px] pointer-events-none translate-x-1/2 -translate-y-1/2"></div>
            <div class="absolute bottom-0 left-0 w-96 h-96 bg-secondary/10 rounded-full blur-[80px] pointer-events-none -translate-x-1/2 translate-y-1/2"></div>
            
            <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-5"></div>
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
                <h2 class="text-3xl md:text-5xl font-extrabold text-white mb-6 leading-tight">
                    Siap Bergabung dengan <span class="text-transparent bg-clip-text bg-gradient-to-r from-secondary-light to-secondary">PBJT</span>?
                </h2>
                <p class="text-lg text-slate-400 mb-10 max-w-2xl mx-auto">
                    Daftarkan dirimu sekarang dan jadilah bagian dari generasi profesional yang siap bersaing di dunia industri.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href="/pmb" class="px-8 py-4 bg-gradient-to-r from-secondary-light to-secondary text-slate-900 font-bold rounded-xl shadow-[0_0_20px_rgba(245,158,11,0.3)] hover:shadow-[0_0_30px_rgba(245,158,11,0.5)] hover:-translate-y-1 transition-all duration-300 text-lg">
                        Daftar Sekarang
                    </a>
                    <a href="/biaya-perkuliahan" class="px-8 py-4 bg-white/5 text-white border border-white/10 font-bold rounded-xl hover:bg-white/10 hover:-translate-y-1 transition-all duration-300 backdrop-blur-sm text-lg">
                        Lihat Biaya
                    </a>
                    <a href="/alur-pendaftaran" class="px-8 py-4 bg-white/5 text-white border border-white/10 font-bold rounded-xl hover:bg-white/10 hover:-translate-y-1 transition-all duration-300 backdrop-blur-sm text-lg">
                        Alur Pendaftaran
                    </a>
                </div>
            </div>
        </section>
    </main>
    

    <!-- HTML Templates -->
    <template id="skeleton-template">
        <article class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden">
            <div class="h-48 bg-slate-200 animate-pulse"></div>
            <div class="p-6">
                <div class="h-4 bg-slate-200 rounded w-1/3 mb-4 animate-pulse"></div>
                <div class="h-6 bg-slate-200 rounded w-full mb-2 animate-pulse"></div>
                <div class="h-6 bg-slate-200 rounded w-4/5 mb-4 animate-pulse"></div>
                <div class="h-4 bg-slate-200 rounded w-full mb-2 animate-pulse"></div>
                <div class="h-4 bg-slate-200 rounded w-2/3 animate-pulse"></div>
            </div>
        </article>
    </template>

    <template id="article-template">
        <article class="bg-white rounded-2xl shadow-sm border border-slate-100 overflow-hidden hover:shadow-xl hover:shadow-primary/5 hover:-translate-y-2 transition-all duration-300 group opacity-0 translate-y-4 animate-[fadeIn_0.5s_ease-out_forwards]">
            <div class="h-48 overflow-hidden image-container">
                <!-- Image goes here -->
            </div>
            <div class="p-6">
                <p class="text-xs font-semibold text-primary mb-3 date-container"></p>
                <h4 class="text-xl font-bold text-slate-800 mb-3 leading-tight group-hover:text-primary transition-colors title-container"></h4>
                <div class="text-slate-500 text-sm line-clamp-3 mb-4 excerpt-container"></div>
                <a href="#" class="inline-flex items-center font-semibold text-secondary-dark hover:text-primary transition-colors link-container">
                    Baca Selengkapnya <span class="ml-1">›</span>
                </a>
            </div>
        </article>
    </template>

    <!-- Client-Side Fetch Logic -->
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const container = document.getElementById('news-container');
            const errorEl = document.getElementById('news-error');
            const skeletonTpl = document.getElementById('skeleton-template');
            const articleTpl = document.getElementById('article-template');

            // 1. Render 3 Skeletons immediately
            for(let i=0; i<3; i++) {
                container.appendChild(skeletonTpl.content.cloneNode(true));
            }

            try {
                // 2. Fetch Data from API
                const response = await fetch('https://wp.pbjt.ac.id/wp-json/wp/v2/posts?_embed&per_page=3');
                if(!response.ok) throw new Error('API Error');
                const posts = await response.json();

                // 3. Remove Skeletons
                container.innerHTML = '';

                // 4. Render Actual Articles
                if (posts.length === 0) {
                    container.innerHTML = '<div class="col-span-3 text-center py-12 text-slate-500">Belum ada berita.</div>';
                    return;
                }

                posts.forEach((post, index) => {
                    const clone = articleTpl.content.cloneNode(true);
                    
                    // Setup Image
                    const imgContainer = clone.querySelector('.image-container');
                    if (post._embedded && post._embedded['wp:featuredmedia']) {
                        imgContainer.innerHTML = `<img src="${post._embedded['wp:featuredmedia'][0].source_url}" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />`;
                    } else {
                        imgContainer.innerHTML = `<div class="w-full h-full bg-slate-100 flex items-center justify-center text-slate-400">No Image</div>`;
                        imgContainer.classList.remove('overflow-hidden');
                    }

                    // Setup Content
                    clone.querySelector('.date-container').textContent = new Date(post.date).toLocaleDateString('id-ID', { year: 'numeric', month: 'long', day: 'numeric' });
                    clone.querySelector('.title-container').innerHTML = post.title.rendered;
                    clone.querySelector('.excerpt-container').innerHTML = post.excerpt.rendered;
                    
                    // Setup Links
                    const link = `/berita/${post.slug}`;
                    clone.querySelector('.title-container').parentElement.parentElement.onclick = () => window.location.href = link;
                    clone.querySelector('.link-container').href = link;
                    
                    // Add staggered delay to animation
                    clone.querySelector('article').style.animationDelay = `${index * 0.15}s`;

                    container.appendChild(clone);
                });

            } catch(e) {
                console.error(e);
                container.innerHTML = '';
                errorEl.classList.remove('hidden');
            }
        });
    </script>

    <style>
        @keyframes fadeIn {
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</MainLayout>
