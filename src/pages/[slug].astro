---
import MainLayout from '../layouts/MainLayout.astro';
import pagesData from '../data/pages.json';

export async function getStaticPaths() {
    const existingExplicitPages = new Set([
        'akreditasi',
        'alur-pendaftaran',
        'beasiswa-kip-kuliah',
        'biaya-perkuliahan',
        'd3-teknik-elektronika-industri',
        'd3-teknik-informatika',
        'd3-teknik-mesin',
        'd3-teknik-otomotif',
        'mikrotik-academy',
        'pmb',
        'profil-politeknik-baja-tegal',
        'dosen',
        'berita',
        'fasilitas',
        'kegiatan-ukm',
        'sample-page',
        'beranda',
    ]);

    const validPages = pagesData.filter((page) => {
        if (!page.slug) return false;
        // Abaikan slug yang sudah dibuatkan file halaman statis tersendiri atau halaman sampah
        if (existingExplicitPages.has(page.slug)) return false;
        // Abaikan slug duplicate hasil import WordPress lama (*-2)
        if (/-2$/.test(page.slug)) return false;
        return true;
    });

    return validPages.map((page) => ({
        params: { slug: page.slug },
        props: { page }
    }));
}

const { page } = Astro.props;

// Ekstrak Caption dari konten untuk dijadikan Alt Text
let altText = page.title.rendered; // Default alt text
let rawContent = page.content.rendered || '';

// Cari teks yang diawali dengan strip, en-dash, atau em-dash
const captionRegex = /<p>\s*[-–—](.*?)\s*<\/p>/i;
const match = rawContent.match(captionRegex);
if (match && match[1]) {
    altText = match[1].replace(/<[^>]*>?/gm, '').trim(); 
    rawContent = rawContent.replace(captionRegex, '');
} else {
    // Fallback jika tidak ada tag <p>
    const rawCaptionRegex = /[-–—]\s*(Sertifikat Akreditasi.*?)(?=<|$)/i;
    const rawMatch = rawContent.match(rawCaptionRegex);
    if (rawMatch && rawMatch[1]) {
        altText = rawMatch[1].replace(/<[^>]*>?/gm, '').trim();
        rawContent = rawContent.replace(rawCaptionRegex, '');
    }
}

// Ekstrak Gambar Unggulan (Featured Image) jika ada
let featuredImageHtml = '';
if (page._embedded && page._embedded['wp:featuredmedia'] && page._embedded['wp:featuredmedia'].length > 0) {
    const imgUrl = page._embedded['wp:featuredmedia'][0].source_url;
    featuredImageHtml = `
    <div class="mt-10 mb-8 rounded-3xl overflow-hidden shadow-xl border border-slate-100 bg-slate-50 p-3 w-fit mx-auto">
        <img src="${imgUrl}" alt="${altText}" title="${altText}" class="max-w-full h-auto max-h-[600px] object-contain hover:scale-105 transition-transform duration-700 rounded-2xl" />
    </div>`;
}

// Bersihkan konten dari hardcoded dimensions & srcset
let cleanContent = rawContent.replace(/-\d+x\d+(?=\.(jpg|jpeg|png|webp|gif))/gi, '');
cleanContent = cleanContent.replace(/srcset="[^"]*"/gi, '');
cleanContent = cleanContent.replace(/sizes="[^"]*"/gi, '');
cleanContent = cleanContent.replace(/hidden/g, ''); // Unhide PDF embeds
---

<MainLayout title={`${page.title.rendered} - Politeknik Baja Tegal`}>

    <!-- Latar Belakang Putih Bersih Penuh -->
    <main class="py-16 bg-white min-h-screen">
        <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Header Judul Elegan (Rata Kiri, Bersih) -->
            <header id="page-header" class="mb-12 border-b border-slate-100 pb-8">
                <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-blue-900 leading-tight border-l-4 border-blue-500 pl-6 py-2 tracking-tight" set:html={page.title.rendered}></h1>
                <Fragment set:html={featuredImageHtml} />
            </header>

            <!-- Area Konten Tanpa Bingkai (Seamless) -->
            <div id="page-content" class="prose prose-lg prose-slate prose-a:text-blue-600 hover:prose-a:text-blue-700 prose-headings:text-slate-900 mx-auto max-w-none break-words overflow-x-auto leading-relaxed prose-hr:my-10 prose-hr:border-slate-200 prose-hr:border-t-2 animate-[fadeIn_0.5s_ease-out_forwards]" set:html={cleanContent}>
            </div>
            
        </article>
    </main>

    <style is:global>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Gambar Standar: Sedikit Radius dan Shadow yang Sangat Lembut agar tidak mencolok */
        .prose img {
            max-width: 100%;
            height: auto;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); 
        }
        
        /* Blok Media & Teks Gutenberg: Memperbesar Porsi Gambar Menjadi 60% */
        .prose .wp-block-media-text {
            display: grid;
            grid-template-columns: 1fr;
            gap: 3rem;
            align-items: start;
            margin-bottom: 3.5rem;
        }
        @media (min-width: 768px) {
            /* Rasio Baru: 60% Gambar : 40% Teks (Gambar Lebih Besar & Dominan) */
            .prose .wp-block-media-text.has-media-on-the-right {
                grid-template-columns: 2fr 3fr; /* Teks 2 bagian, Gambar 3 bagian (kanan) */
            }
            .prose .wp-block-media-text:not(.has-media-on-the-right) {
                grid-template-columns: 3fr 2fr; /* Gambar 3 bagian (kiri), Teks 2 bagian */
            }
        }
        .prose .wp-block-media-text figure {
            margin: 0;
        }
        .prose .wp-block-media-text img {
            width: 100%;
            max-width: 100%;
            object-fit: cover;
            border-radius: 0.5rem;
        }
        
        /* =========================================
           OPTIMASI GAMBAR STANDALONE (SPRINT 21)
           ========================================= */
        
        /* 1. Targetkan Blok Gambar Bawaan Gutenberg */
        .prose .wp-block-image {
            display: flex;
            justify-content: center;
            margin-top: 3rem;
            margin-bottom: 3rem;
            width: 100%;
        }
        
        /* 2. Targetkan Gambar yang sekadar ditaruh di dalam teks (Paragraf) */
        .prose > p > img {
            display: block;
            margin-left: auto;
            margin-right: auto;
            margin-top: 2rem;
            margin-bottom: 2rem;
        }

        /* 3. Aturan Ukuran (Mobile vs Desktop) */
        .prose .wp-block-image img, 
        .prose > p > img,
        .prose .aligncenter {
            width: 100%; /* Default Mobile: Rentang Penuh */
            height: auto;
            max-width: none !important;
        }
        
        @media (min-width: 768px) {
            .prose .wp-block-image img, 
            .prose > p > img,
            .prose .aligncenter {
                width: 80%; /* Desktop: Dibesarkan Proporsional (Digedein Dikit) tapi tidak pecah */
                max-width: 900px; 
            }
        }
    </style>
</MainLayout>
