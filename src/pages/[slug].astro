---
export async function getStaticPaths() {
    // Semua slug asli dari database WordPress (hasil analisis SQL dump)
    const slugs = [
        'tentang-pbjt', 'profil-politeknik-baja-tegal', 'struktur-politeknik-baja-tegal',
        'biro', 'akreditasi', 'perguruan-tinggi',
        'program-studi', 'd3-teknik-informatika', 'd3-teknik-otomotif',
        'd3-teknik-mesin', 'd3-teknik-elektronika-industri', 'mikrotik-academy',
        'informasi-training', 'galeri-training',
        'bem', 'rohis', 'racana', 'bajapala', 'badminton', 'futsal',
        'paduan-suara', 'forum-studi-ilmiah-fosil', 'hmti',
        'pmb', 'alur-pendaftaran', 'biaya-perkuliahan',
        'beasiswa', 'beasiswa-kip-kuliah', 'beasiswa-yayasan',
        'daftar-alumni', 'siakad', 'kuliah-online', 'lowongan',
        'magang', 'internasional', 'beranda', 'berita'
    ];
    return slugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Memuat... - Politeknik Baja Tegal">

    <main class="min-h-screen bg-slate-50 pb-24">
        
        <!-- Hero Banner Latar Gelap -->
        <div class="relative bg-slate-900 pt-32 pb-32 overflow-hidden">
            <div class="absolute inset-0 bg-blue-900/20"></div>
            <div class="relative max-w-5xl mx-auto px-4 text-center z-10" id="page-header">
                <!-- Skeleton Header -->
                <div class="h-12 bg-slate-700/50 rounded-xl w-2/3 md:w-1/2 mx-auto animate-pulse mb-4"></div>
                <div class="h-4 bg-slate-700/50 rounded w-1/4 mx-auto animate-pulse"></div>
            </div>
        </div>

        <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 -mt-24 relative z-20">
            
            <!-- White Card Container -->
            <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100 p-8 md:p-12 lg:p-16">
                <!-- Skeleton Content -->
                <div id="page-content" class="prose prose-lg prose-slate prose-a:text-blue-600 hover:prose-a:text-blue-700 prose-headings:text-slate-900 prose-img:rounded-2xl prose-img:shadow-lg mx-auto max-w-none break-words overflow-x-auto leading-relaxed prose-hr:my-12 prose-hr:border-slate-200 prose-hr:border-t-2">
                    <div class="space-y-6">
                        <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                        <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                        <div class="h-4 bg-slate-200 rounded w-4/5 animate-pulse"></div>
                        <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                        <div class="h-4 bg-slate-200 rounded w-3/4 animate-pulse"></div>
                    </div>
                </div>
            </div>
            
        </article>
    </main>


    <!-- Client-Side Fetch Logic -->
    <script define:vars={{ slug }}>
        document.addEventListener('DOMContentLoaded', async () => {
            const header = document.getElementById('page-header');
            const content = document.getElementById('page-content');
            
            try {
                const response = await fetch(`https://pbjt.ac.id/wp-json/wp/v2/pages?_embed&slug=${slug}`);
                if(!response.ok) throw new Error('API Error');
                
                const pages = await response.json();
                
                if (pages.length === 0) {
                    document.title = "Halaman Tidak Ditemukan - PBJT";
                    header.innerHTML = `<h1 class="text-4xl font-bold text-red-500 mb-4">404</h1>
                                        <div class="w-24 h-1 bg-red-500 mx-auto rounded-full"></div>`;
                    content.innerHTML = `<p class="text-center text-slate-600">Maaf, halaman dengan URL '/${slug}' belum dibuat di WordPress Anda. Silakan buat Page baru di Dashboard WP dengan judul tersebut.</p>`;
                    return;
                }
                
                const page = pages[0];
                
                // Update Title
                document.title = `${page.title.rendered} - Politeknik Baja Tegal`;
                
                // Update Header (Teks Putih Rata Tengah)
                header.innerHTML = `<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-tight mb-6 tracking-tight">${page.title.rendered}</h1>
                                    <div class="w-24 h-1.5 bg-gradient-to-r from-blue-400 to-cyan-300 mx-auto rounded-full shadow-lg"></div>`;
                
                // Update Content
                content.innerHTML = page.content.rendered;
                content.classList.add('animate-[fadeIn_0.5s_ease-out_forwards]');
                
            } catch(e) {
                console.error(e);
                header.innerHTML = `<h1 class="text-4xl font-bold text-red-500 mb-4">Gagal Memuat</h1>
                                    <div class="w-24 h-1 bg-red-500 mx-auto rounded-full"></div>`;
                content.innerHTML = `<p class="text-center text-red-500">Terjadi kesalahan saat menarik data dari server. Pastikan API tidak terblokir.</p>`;
            }
        });
    </script>

    <style is:global>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Memastikan gambar standar tampil proporsional, elegan, dan tidak kerdil */
        .prose img {
            max-width: 100%;
            height: auto;
            border-radius: 1rem;
            box-shadow: 0 10px 25px -5px rgb(0 0 0 / 0.1), 0 8px 10px -6px rgb(0 0 0 / 0.1); 
        }
        
        /* Perbaikan khusus untuk blok Media & Teks Gutenberg agar gambar berukuran Ideal (50:50 di layar lebar) */
        .prose .wp-block-media-text {
            display: grid;
            grid-template-columns: 1fr;
            gap: 3rem;
            align-items: start;
            margin-bottom: 3.5rem;
        }
        @media (min-width: 768px) {
            /* Rasio Emas: 50% Gambar : 50% Teks (Karena Kontainer Sudah Lebar 1024px) */
            .prose .wp-block-media-text.has-media-on-the-right {
                grid-template-columns: 1fr 1fr; 
            }
            .prose .wp-block-media-text:not(.has-media-on-the-right) {
                grid-template-columns: 1fr 1fr; 
            }
        }
        .prose .wp-block-media-text figure {
            margin: 0;
        }
        .prose .wp-block-media-text img {
            width: 100%;
            max-width: 100%;
            object-fit: cover;
            border-radius: 1rem;
        }
        
        /* Perbaikan khusus untuk Gambar yang di-Align Center (BEM) agar bisa lebih lebar */
        .prose .aligncenter {
            text-align: center;
            margin-left: auto;
            margin-right: auto;
            display: block;
            max-width: 700px !important; /* Diperbesar dari 450px agar foto lanskap terlihat gagah */
        }
    </style>
</MainLayout>
