---
export async function getStaticPaths() {
    // Semua slug asli dari database WordPress (hasil analisis SQL dump)
    const slugs = [
        'tentang-pbjt', 'profil-politeknik-baja-tegal', 'struktur-politeknik-baja-tegal',
        'biro', 'akreditasi', 'perguruan-tinggi',
        'program-studi', 'd3-teknik-informatika', 'd3-teknik-otomotif',
        'd3-teknik-mesin', 'd3-teknik-elektronika-industri', 'mikrotik-academy',
        'informasi-training', 'galeri-training',
        'bem', 'rohis', 'racana', 'bajapala', 'badminton', 'futsal',
        'paduan-suara', 'forum-studi-ilmiah-fosil', 'hmti',
        'pmb', 'alur-pendaftaran', 'biaya-perkuliahan',
        'beasiswa', 'beasiswa-kip-kuliah', 'beasiswa-yayasan',
        'daftar-alumni', 'siakad', 'kuliah-online', 'lowongan',
        'magang', 'internasional', 'beranda', 'berita'
    ];
    return slugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Memuat... - Politeknik Baja Tegal">

    <!-- Latar Belakang Putih Bersih Penuh -->
    <main class="py-16 bg-white min-h-screen">
        <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Header Judul Elegan (Rata Kiri, Bersih) -->
            <header id="page-header" class="mb-12 border-b border-slate-100 pb-8">
                <!-- Skeleton Header -->
                <div class="h-12 bg-slate-200 rounded w-2/3 md:w-1/2 animate-pulse"></div>
            </header>

            <!-- Area Konten Tanpa Bingkai (Seamless) -->
            <div id="page-content" class="prose prose-lg prose-slate prose-a:text-blue-600 hover:prose-a:text-blue-700 prose-headings:text-slate-900 mx-auto max-w-none break-words overflow-x-auto leading-relaxed prose-hr:my-10 prose-hr:border-slate-200 prose-hr:border-t-2">
                <!-- Skeleton Content -->
                <div class="space-y-6">
                    <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                    <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                    <div class="h-4 bg-slate-200 rounded w-4/5 animate-pulse"></div>
                    <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                    <div class="h-4 bg-slate-200 rounded w-3/4 animate-pulse"></div>
                </div>
            </div>
            
        </article>
    </main>


    <!-- Client-Side Fetch Logic -->
    <script define:vars={{ slug }}>
        document.addEventListener('DOMContentLoaded', async () => {
            const header = document.getElementById('page-header');
            const content = document.getElementById('page-content');
            
            try {
                const response = await fetch(`https://wp.pbjt.ac.id/wp-json/wp/v2/pages?_embed&slug=${slug}`);
                if(!response.ok) throw new Error('API Error');
                
                const pages = await response.json();
                
                if (pages.length === 0) {
                    document.title = "Halaman Tidak Ditemukan - PBJT";
                    header.innerHTML = `<h1 class="text-4xl font-bold text-red-500 mb-4 border-l-4 border-red-500 pl-4">404 - Halaman Tidak Ditemukan</h1>`;
                    content.innerHTML = `<p class="text-slate-600 text-lg">Maaf, halaman dengan URL '/${slug}' belum dibuat di WordPress Anda. Silakan buat Page baru di Dashboard WP dengan judul tersebut.</p>`;
                    return;
                }
                
                const page = pages[0];
                
                // Update Title
                document.title = `${page.title.rendered} - Politeknik Baja Tegal`;
                
                // Update Header (Teks Biru Megah Rata Kiri dengan Aksen Garis)
                header.innerHTML = `<h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-blue-900 leading-tight border-l-4 border-blue-500 pl-6 py-2 tracking-tight">${page.title.rendered}</h1>`;
                
                // Update Content
                // SPRINT 22: Resolusi Gambar Anti-Blur (HD)
                // 1. Hapus akhiran dimensi (misal -300x200) dari nama file agar mengambil gambar master
                let cleanContent = page.content.rendered.replace(/-\d+x\d+(?=\.(jpg|jpeg|png|webp|gif))/gi, '');
                
                // 2. Musnahkan atribut srcset dan sizes bawaan WP yang menyuruh browser download gambar kecil
                cleanContent = cleanContent.replace(/srcset="[^"]*"/gi, '');
                cleanContent = cleanContent.replace(/sizes="[^"]*"/gi, '');
                
                content.innerHTML = cleanContent;
                content.classList.add('animate-[fadeIn_0.5s_ease-out_forwards]');
                
                // 3. Tampilkan PDF (Hapus atribut hidden dari File Block)
                content.querySelectorAll('.wp-block-file__embed').forEach(pdf => {
                    pdf.removeAttribute('hidden');
                });
                
            } catch(e) {
                console.error(e);
                header.innerHTML = `<h1 class="text-4xl font-bold text-red-500 mb-4 border-l-4 border-red-500 pl-4">Gagal Memuat</h1>`;
                content.innerHTML = `<p class="text-red-500 text-lg">Terjadi kesalahan saat menarik data dari server. Pastikan API tidak terblokir.</p>`;
            }
        });
    </script>

    <style is:global>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
        
        /* Gambar Standar: Sedikit Radius dan Shadow yang Sangat Lembut agar tidak mencolok */
        .prose img {
            max-width: 100%;
            height: auto;
            border-radius: 0.5rem;
            box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1), 0 2px 4px -2px rgb(0 0 0 / 0.1); 
        }
        
        /* Blok Media & Teks Gutenberg: Memperbesar Porsi Gambar Menjadi 60% */
        .prose .wp-block-media-text {
            display: grid;
            grid-template-columns: 1fr;
            gap: 3rem;
            align-items: start;
            margin-bottom: 3.5rem;
        }
        @media (min-width: 768px) {
            /* Rasio Baru: 60% Gambar : 40% Teks (Gambar Lebih Besar & Dominan) */
            .prose .wp-block-media-text.has-media-on-the-right {
                grid-template-columns: 2fr 3fr; /* Teks 2 bagian, Gambar 3 bagian (kanan) */
            }
            .prose .wp-block-media-text:not(.has-media-on-the-right) {
                grid-template-columns: 3fr 2fr; /* Gambar 3 bagian (kiri), Teks 2 bagian */
            }
        }
        .prose .wp-block-media-text figure {
            margin: 0;
        }
        .prose .wp-block-media-text img {
            width: 100%;
            max-width: 100%;
            object-fit: cover;
            border-radius: 0.5rem;
        }
        
        /* =========================================
           OPTIMASI GAMBAR STANDALONE (SPRINT 21)
           ========================================= */
        
        /* 1. Targetkan Blok Gambar Bawaan Gutenberg */
        .prose .wp-block-image {
            display: flex;
            justify-content: center;
            margin-top: 3rem;
            margin-bottom: 3rem;
            width: 100%;
        }
        
        /* 2. Targetkan Gambar yang sekadar ditaruh di dalam teks (Paragraf) */
        .prose > p > img {
            display: block;
            margin-left: auto;
            margin-right: auto;
            margin-top: 2rem;
            margin-bottom: 2rem;
        }

        /* 3. Aturan Ukuran (Mobile vs Desktop) */
        .prose .wp-block-image img, 
        .prose > p > img,
        .prose .aligncenter {
            width: 100%; /* Default Mobile: Rentang Penuh */
            height: auto;
            max-width: none !important;
        }
        
        @media (min-width: 768px) {
            .prose .wp-block-image img, 
            .prose > p > img,
            .prose .aligncenter {
                width: 80%; /* Desktop: Dibesarkan Proporsional (Digedein Dikit) tapi tidak pecah */
                max-width: 900px; 
            }
        }
    </style>
</MainLayout>
