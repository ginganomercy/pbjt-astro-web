---
export async function getStaticPaths() {
    // Semua slug asli dari database WordPress (hasil analisis SQL dump)
    const slugs = [
        'tentang-pbjt', 'profil-politeknik-baja-tegal', 'struktur-politeknik-baja-tegal',
        'biro', 'akreditasi', 'perguruan-tinggi',
        'program-studi', 'd3-teknik-informatika', 'd3-teknik-otomotif',
        'd3-teknik-mesin', 'd3-teknik-elektronika-industri', 'mikrotik-academy',
        'informasi-training', 'galeri-training',
        'bem', 'rohis', 'racana', 'bajapala', 'badminton', 'futsal',
        'paduan-suara', 'forum-studi-ilmiah-fosil', 'hmti',
        'pmb', 'alur-pendaftaran', 'biaya-perkuliahan',
        'beasiswa', 'beasiswa-kip-kuliah', 'beasiswa-yayasan',
        'daftar-alumni', 'siakad', 'kuliah-online', 'lowongan',
        'magang', 'internasional', 'beranda', 'berita'
    ];
    return slugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;
---

<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Memuat... - Politeknik Baja Tegal</title>
</head>
<body class="bg-background text-text font-sans">
    <style is:global>
        @keyframes scroll-text {
            0% { transform: translateX(100vw); }
            100% { transform: translateX(-100%); }
        }
        .ticker-animate {
            display: inline-block;
            white-space: nowrap;
            animation: scroll-text 25s linear infinite;
            will-change: transform;
        }
        .ticker-animate:hover {
            animation-play-state: paused;
        }
    </style>
    <!-- Top Announcement Ticker -->
    <div class="bg-primary-dark text-secondary-light text-base font-semibold py-3 overflow-hidden whitespace-nowrap relative z-[60] border-b border-primary/20">
        <div class="ticker-animate">
            <span class="inline-flex items-center gap-3 px-4">
                <span class="flex h-3 w-3 rounded-full bg-secondary animate-pulse shadow-[0_0_10px_rgba(245,158,11,1)]"></span>
                Pengumuman: Penerimaan Mahasiswa Baru Tahun Ajaran 2026/2027 Telah Resmi Dibuka! Segera Daftarkan Dirimu, Gelombang Pertama Ditutup Bulan Ini!
