---
import MainLayout from '../../layouts/MainLayout.astro';
---

<MainLayout title="Memuat Profil Dosen... - Politeknik Baja Tegal">
    <main class="py-16 bg-white min-h-screen">
        <article class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <div class="mb-8">
                <a href="/dosen" class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors group">
                    <svg class="w-4 h-4 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali ke Daftar Dosen
                </a>
            </div>

            <!-- Skeleton Loader -->
            <div id="profil-skeleton" class="flex flex-col md:flex-row gap-12 mt-8">
                <div class="w-full md:w-1/3 flex-shrink-0">
                    <div class="aspect-[3/4] bg-slate-200 rounded-3xl animate-pulse"></div>
                </div>
                <div class="w-full md:w-2/3 space-y-6">
                    <div class="h-10 bg-slate-200 rounded w-3/4 animate-pulse"></div>
                    <div class="h-6 bg-slate-200 rounded w-1/4 mb-10 animate-pulse"></div>
                    
                    <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                    <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                    <div class="h-4 bg-slate-200 rounded w-5/6 animate-pulse"></div>
                </div>
            </div>

            <!-- Container Konten Asli -->
            <div id="profil-container" class="hidden flex-col md:flex-row gap-12 items-start mt-8">
                
                <!-- Kolom Foto -->
                <div class="w-full md:w-1/3 flex-shrink-0 sticky top-24">
                    <div class="rounded-3xl overflow-hidden shadow-2xl border-4 border-white bg-slate-50 relative group">
                        <img id="profil-img" src="" alt="Foto Dosen" class="w-full aspect-[3/4] object-cover hover:scale-105 transition-transform duration-700" />
                        <div class="absolute inset-0 ring-1 ring-inset ring-black/10 rounded-3xl pointer-events-none"></div>
                    </div>
                </div>

                <!-- Kolom Biografi -->
                <div class="w-full md:w-2/3">
                    <header class="mb-10 border-b border-slate-100 pb-8">
                        <h1 id="profil-name" class="text-4xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-3">Memuat...</h1>
                        <p class="text-xl text-blue-600 font-medium flex items-center gap-2">
                            <svg class="w-6 h-6 text-blue-500" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                            </svg>
                            Dosen Politeknik Baja Tegal
                        </p>
                    </header>

                    <div id="profil-content" class="prose prose-lg prose-slate prose-a:text-blue-600 max-w-none">
                        <!-- Biografi akan dimasukkan di sini -->
                    </div>
                </div>
                
            </div>
            
            <div id="profil-error" class="hidden text-center py-20 mt-8 bg-red-50 rounded-3xl border border-red-100">
                <h1 class="text-4xl font-bold text-red-500 mb-4">Gagal Memuat Profil</h1>
                <p class="text-slate-600 text-lg">Dosen yang Anda cari tidak ditemukan atau terjadi gangguan koneksi ke server.</p>
            </div>

        </article>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const urlParams = new URLSearchParams(window.location.search);
            const slug = urlParams.get('id');
            
            const skeleton = document.getElementById('profil-skeleton');
            const container = document.getElementById('profil-container');
            const errorEl = document.getElementById('profil-error');
            
            if (!slug) {
                skeleton.classList.add('hidden');
                errorEl.classList.remove('hidden');
                return;
            }

            try {
                const response = await fetch(`https://wp.pbjt.ac.id/wp-json/wp/v2/dosen?_embed&slug=${slug}`);
                if (!response.ok) throw new Error('API Error');
                
                const dosenList = await response.json();
                
                if (dosenList.length === 0) {
                    throw new Error('Dosen tidak ditemukan');
                }
                
                const dosen = dosenList[0];
                
                // Update Metadata HTML
                document.title = `${dosen.title.rendered} - Profil Dosen PBJT`;
                
                // Set Data ke DOM
                document.getElementById('profil-name').innerHTML = dosen.title.rendered;
                
                const img = document.getElementById('profil-img');
                if (dosen._embedded && dosen._embedded['wp:featuredmedia'] && dosen._embedded['wp:featuredmedia'].length > 0) {
                    img.src = dosen._embedded['wp:featuredmedia'][0].source_url;
                } else {
                    img.src = '/placeholder-dosen.jpg';
                }
                
                const contentEl = document.getElementById('profil-content');
                if (dosen.content && dosen.content.rendered) {
                    contentEl.innerHTML = dosen.content.rendered;
                } else {
                    contentEl.innerHTML = '<p class="text-slate-500 italic">Belum ada biografi atau detail profil untuk dosen ini.</p>';
                }
                
                // Animasi Tampil
                skeleton.classList.add('hidden');
                container.classList.remove('hidden');
                container.classList.add('animate-[fadeIn_0.5s_ease-out_forwards]');
                
            } catch (e) {
                console.error(e);
                skeleton.classList.add('hidden');
                errorEl.classList.remove('hidden');
            }
        });
    </script>
    
    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</MainLayout>
