---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Alur Pendaftaran - Politeknik Baja Tegal">
    <main class="bg-slate-50 min-h-screen py-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <header class="text-center mb-12">
                <a href="/pmb" class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors mb-6 group">
                    <svg class="w-4 h-4 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali ke Info PMB
                </a>
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">Alur Pendaftaran</h1>
                <p class="text-xl text-slate-500">Panduan Lengkap Pendaftaran Mahasiswa Baru</p>
            </header>

            <!-- Skeleton Loader -->
            <div id="alur-skeleton" class="flex flex-col md:flex-row gap-8">
                <div class="w-full md:w-2/3 h-[500px] bg-slate-200 rounded-3xl animate-pulse"></div>
                <div class="w-full md:w-1/3 h-[200px] bg-slate-200 rounded-3xl animate-pulse"></div>
            </div>

            <!-- Kontainer Utama -->
            <div id="alur-container" class="hidden grid-cols-1 lg:grid-cols-3 gap-8 items-start">
                
                <!-- Kolom Kiri: Diagram Alur -->
                <div class="lg:col-span-2 bg-white p-6 md:p-8 rounded-[2.5rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 flex flex-col group relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-50 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/2 pointer-events-none"></div>
                    
                    <h3 class="text-2xl font-bold text-slate-800 mb-8 flex items-center gap-3 relative z-10">
                        <span class="w-2 h-8 bg-gradient-to-b from-blue-500 to-indigo-600 rounded-full"></span>
                        Diagram Pendaftaran
                    </h3>
                    
                    <div id="alur-diagram" class="w-full flex justify-center bg-slate-50/50 rounded-3xl overflow-hidden p-6 md:p-10 relative z-10 border border-slate-100 min-h-[300px] items-center">
                        <!-- Image goes here -->
                    </div>
                </div>

                <!-- Kolom Kanan: Panduan PDF & Bantuan -->
                <div class="lg:col-span-1 flex flex-col gap-6 sticky top-24">
                    
                    <!-- Box Unduh Panduan -->
                    <div class="bg-gradient-to-br from-slate-900 via-blue-900 to-indigo-900 rounded-[2.5rem] p-8 text-white shadow-2xl relative overflow-hidden group">
                        <div class="absolute top-0 right-0 w-40 h-40 bg-white opacity-5 rounded-full -translate-y-1/2 translate-x-1/3 group-hover:scale-110 transition-transform duration-700"></div>
                        <div class="absolute bottom-0 left-0 w-32 h-32 bg-blue-500 opacity-20 rounded-full translate-y-1/2 -translate-x-1/2 group-hover:scale-110 transition-transform duration-700"></div>
                        
                        <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center mb-6 backdrop-blur-sm border border-white/20">
                            <svg class="w-7 h-7 text-blue-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                        </div>
                        
                        <h3 class="text-2xl font-bold mb-3 relative z-10 text-transparent bg-clip-text bg-gradient-to-r from-white to-blue-200">Buku Panduan</h3>
                        <p class="text-blue-100/80 mb-8 relative z-10 leading-relaxed text-sm">Unduh dokumen PDF panduan pendaftaran selengkapnya agar proses registrasi Anda lancar.</p>
                        
                        <div id="alur-pdf-container" class="relative z-10">
                            <!-- Download button goes here -->
                        </div>
                    </div>

                    <!-- Box Bantuan -->
                    <div class="bg-white rounded-[2.5rem] p-8 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 hover:border-green-100 transition-colors duration-300">
                        <div class="w-12 h-12 bg-green-50 rounded-2xl flex items-center justify-center mb-5">
                            <svg class="w-6 h-6 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
                        </div>
                        <h3 class="text-xl font-bold text-slate-800 mb-3">Butuh Bantuan?</h3>
                        <p class="text-slate-500 text-sm mb-6 leading-relaxed">Mengalami kendala teknis? Tim IT kami siap membantu Anda.</p>
                        <a href="https://wa.me/6281234567890" target="_blank" class="flex items-center justify-center gap-2 w-full py-4 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold rounded-xl transition-all duration-300 shadow-lg shadow-green-500/30 hover:shadow-green-500/50 hover:-translate-y-1">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 0C5.385 0 0 5.385 0 12.031c0 2.124.551 4.135 1.517 5.918L.003 24l6.22-1.633a11.968 11.968 0 005.808 1.495h.005c6.645 0 12.031-5.386 12.031-12.031C24.062 5.385 18.676 0 12.031 0zm0 21.84c-1.782 0-3.535-.48-5.068-1.39l-.364-.216-3.766.988.998-3.67-.236-.375A9.976 9.976 0 012.052 12.03c0-5.512 4.485-9.997 9.98-9.997 2.671 0 5.184 1.04 7.07 2.928 1.888 1.888 2.928 4.4 2.928 7.07 0 5.51-4.486 9.998-9.998 9.998z"/></svg>
                            Hubungi via WhatsApp
                        </a>
                    </div>
                    
                </div>
                
            </div>
            
            <!-- Error State -->
            <div id="alur-error" class="hidden text-center py-24 bg-white rounded-3xl border border-red-100 shadow-sm mt-8">
                <div class="w-20 h-20 bg-red-50 rounded-full flex items-center justify-center mx-auto mb-6">
                    <svg class="w-10 h-10 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                </div>
                <h3 class="text-3xl font-extrabold text-slate-900 mb-3">Gagal Memuat Informasi</h3>
                <p class="text-slate-500 max-w-md mx-auto">Terjadi kesalahan saat memuat data alur pendaftaran dari server. Silakan muat ulang halaman.</p>
            </div>

        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const skeleton = document.getElementById('alur-skeleton');
            const container = document.getElementById('alur-container');
            const diagramContainer = document.getElementById('alur-diagram');
            const pdfContainer = document.getElementById('alur-pdf-container');
            const errorEl = document.getElementById('alur-error');

            try {
                const response = await fetch('https://wp.pbjt.ac.id/wp-json/wp/v2/pages?_embed&slug=alur-pendaftaran');
                if (!response.ok) throw new Error('API Error');
                
                const pages = await response.json();
                if (pages.length === 0) throw new Error('Page not found');
                
                const page = pages[0];
                let rawHtml = page.content.rendered;
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = rawHtml;
                
                // 1. Ekstrak Gambar Diagram (Dengan Validasi Ketat)
                // Filter tracking pixels (ukuran kecil) atau emoji wordpress
                const images = Array.from(tempDiv.querySelectorAll('img'));
                const validImg = images.find(img => {
                    const src = img.src || '';
                    const cls = img.className || '';
                    return !src.includes('data:image') && 
                           !cls.includes('wp-smiley') && 
                           !src.includes('avatar') &&
                           (!img.width || img.width > 50); // Tolak jika ukurannya kurang dari 50px (biasanya tracking pixel)
                });

                if (validImg) {
                    validImg.removeAttribute('srcset');
                    validImg.removeAttribute('sizes');
                    validImg.src = validImg.src.replace(/-\d+x\d+(?=\.(jpg|jpeg|png|webp|gif))/gi, '');
                    validImg.className = 'w-full h-auto max-h-[800px] object-contain drop-shadow-md hover:scale-[1.02] transition-transform duration-500 cursor-zoom-in rounded-xl';
                    diagramContainer.appendChild(validImg);
                } else {
                    diagramContainer.innerHTML = `
                        <div class="w-full py-20 flex flex-col items-center justify-center text-slate-400 text-center">
                            <div class="w-24 h-24 bg-white rounded-full flex items-center justify-center shadow-sm mb-6 border border-slate-100">
                                <svg class="w-10 h-10 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            </div>
                            <h4 class="text-xl font-bold text-slate-700 mb-2">Diagram Belum Diunggah</h4>
                            <p class="text-slate-500 max-w-sm">Admin kampus belum mengunggah gambar diagram alur pendaftaran mahasiswa baru.</p>
                        </div>
                    `;
                }
                
                // 2. Inject Link PDF Lokal (Sesuai file yang diberikan)
                const pdfUrl = encodeURI('/image/UG PMB Gofeeder (Pendaftar).pdf');
                pdfContainer.innerHTML = `
                    <a href="${pdfUrl}" target="_blank" download class="w-full flex items-center justify-center gap-3 py-4 bg-white text-blue-900 hover:bg-blue-50 font-bold rounded-2xl shadow-[0_0_20px_rgba(255,255,255,0.3)] hover:shadow-[0_0_30px_rgba(255,255,255,0.5)] hover:-translate-y-1 transition-all duration-300 text-lg group">
                        <svg class="w-6 h-6 group-hover:-translate-y-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Unduh File PDF
                    </a>
                `;

                skeleton.classList.add('hidden');
                container.classList.remove('hidden');
                container.classList.add('grid', 'animate-[fadeIn_0.5s_ease-out_forwards]');

            } catch (e) {
                console.error(e);
                skeleton.classList.add('hidden');
                errorEl.classList.remove('hidden');
            }
        });
    </script>
    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</MainLayout>
