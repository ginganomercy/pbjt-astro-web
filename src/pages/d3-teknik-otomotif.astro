---
import ProdiLayout from '../layouts/ProdiLayout.astro';
import { getPageBySlug } from '../utils/api.js';
import { parseOtomotifContent } from '../utils/contentParser.js';

// Ambil teks asli dari WordPress berdasarkan slug halaman
const page = await getPageBySlug('d3-teknik-otomotif');
const title = page?.title?.rendered || "D3 Teknik Otomotif";
const rawContent = page?.content?.rendered || "";

// Ekstrak data kotor menjadi bersih
const { deskripsi, prospek, visi, misi, tujuan } = parseOtomotifContent(rawContent);

// Gambar sertifikat di-hardcode agar aman
const akreditasiImg = "/image/uploads/akreditasi-otomotif.jpg";
---

<ProdiLayout 
    title={title}
    deskripsi={deskripsi}
    prospek={prospek}
    visi={visi}
    misi={misi}
    tujuan={tujuan}
    akreditasiImg={akreditasiImg}
/>
