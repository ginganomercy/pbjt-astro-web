---
import MainLayout from '../layouts/MainLayout.astro';

const prodi = {
  title: "D3 Teknik Otomotif",
  description: "Membentuk tenaga terampil ahli madya di bidang teknik otomotif yang siap kerja di industri perakitan, manufaktur, dan jasa perawatan kendaraan bermotor.",
  akreditasiImg: "https://wp.pbjt.ac.id/wp-content/uploads/2026/09/akreditasi-otomotif.jpg",
  visi: "Menjadi program studi vokasi yang unggul di bidang otomotif dan berwawasan entrepreneur pada tahun 2030.",
  prospek: [
    "Automotive Service Technician",
    "Service Advisor",
    "Workshop Manager / Kepala Bengkel",
    "Automotive Assembler / Manufaktur",
    "Quality Control Otomotif",
    "Wirausaha Bengkel Otomotif"
  ],
  fasilitas: [
    "Bengkel Otomotif Kendaraan Ringan",
    "Laboratorium Mesin Bensin & Diesel",
    "Laboratorium Kelistrikan Otomotif",
    "Peralatan Uji Emisi & Diagnostik Scanner (OBD)"
  ]
};
---

<MainLayout title={`${prodi.title} - Politeknik Baja Tegal`}>
    <main class="min-h-screen bg-slate-50 pt-20 pb-16">
        
        <!-- Hero Section -->
        <div class="relative bg-slate-900 py-24 mb-16 overflow-hidden">
            <div class="absolute inset-0 bg-blue-900/30"></div>
            <div class="relative max-w-7xl mx-auto px-4 text-center">
                <span class="inline-block py-1 px-3 rounded-full bg-blue-500/20 text-blue-300 text-sm font-semibold mb-6 border border-blue-500/30">
                    Program Studi
                </span>
                <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6">
                    {prodi.title}
                </h1>
                <p class="text-xl text-slate-300 max-w-3xl mx-auto">
                    {prodi.description}
                </p>
            </div>
        </div>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
                
                <!-- Kiri: Konten Informasi -->
                <div class="lg:col-span-2 space-y-12">
                    <!-- Visi -->
                    <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100 relative overflow-hidden">
                        <div class="absolute top-0 right-0 p-8 opacity-5">
                            <svg class="w-32 h-32 text-blue-900" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                        </div>
                        <h2 class="text-2xl font-bold text-slate-900 mb-4 flex items-center">
                            <svg class="w-6 h-6 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
                            Visi Program Studi
                        </h2>
                        <p class="text-lg text-slate-600 italic">"{prodi.visi}"</p>
                    </div>

                    <!-- Prospek Karir & Fasilitas -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
                        <!-- Prospek -->
                        <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                            <h3 class="text-xl font-bold text-slate-900 mb-6 border-b pb-4">Prospek Karir</h3>
                            <ul class="space-y-3">
                                {prodi.prospek.map(item => (
                                    <li class="flex items-start">
                                        <svg class="w-5 h-5 text-green-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
                                        <span class="text-slate-600">{item}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>

                        <!-- Fasilitas -->
                        <div class="bg-white p-8 rounded-3xl shadow-sm border border-slate-100">
                            <h3 class="text-xl font-bold text-slate-900 mb-6 border-b pb-4">Fasilitas Pendukung</h3>
                            <ul class="space-y-3">
                                {prodi.fasilitas.map(item => (
                                    <li class="flex items-start">
                                        <svg class="w-5 h-5 text-blue-500 mr-3 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/></svg>
                                        <span class="text-slate-600">{item}</span>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Kanan: Sertifikat Akreditasi -->
                <div class="lg:col-span-1">
                    <div class="bg-slate-900 rounded-3xl p-6 sticky top-28 shadow-xl">
                        <div class="text-center mb-6">
                            <h3 class="text-xl font-bold text-white mb-2">Akreditasi Resmi</h3>
                            <p class="text-slate-400 text-sm">Sertifikat Akreditasi BAN-PT / LAM untuk Program Studi {prodi.title}</p>
                        </div>
                        
                        <div class="relative w-full aspect-[3/4] bg-white rounded-2xl overflow-hidden cursor-pointer group shadow-inner" onclick={`window.open('${prodi.akreditasiImg}', '_blank')`}>
                            <img 
                                src={prodi.akreditasiImg} 
                                alt={`Akreditasi ${prodi.title}`}
                                class="absolute inset-0 w-full h-full object-contain p-2 transition-transform duration-500 group-hover:scale-105"
                            />
                            <div class="absolute inset-0 bg-black/0 group-hover:bg-black/20 transition-colors flex items-center justify-center">
                                <div class="opacity-0 group-hover:opacity-100 bg-white text-slate-900 px-4 py-2 rounded-lg text-sm font-semibold shadow-lg flex items-center transition-opacity">
                                    <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"/></svg>
                                    Lihat Penuh
                                </div>
                            </div>
                        </div>

                        <a href={prodi.akreditasiImg} download target="_blank" class="mt-6 w-full flex justify-center items-center px-4 py-3 border border-transparent text-sm font-bold rounded-xl text-white bg-blue-600 hover:bg-blue-700 transition-colors">
                            Unduh Sertifikat
                        </a>
                    </div>
                </div>

            </div>
        </div>
    </main>
</MainLayout>
