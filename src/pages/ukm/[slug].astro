---
import MainLayout from '../../layouts/MainLayout.astro';
import { getDynamicPosts, getDynamicPostBySlug } from '../../utils/api.js';

export async function getStaticPaths() {
    const items = await getDynamicPosts('ukm', 100);
    return items.map((item) => ({
        params: { slug: item.slug },
        props: { item },
    }));
}

const { slug } = Astro.params;
let { item } = Astro.props;

if (!item) {
    item = await getDynamicPostBySlug('ukm', slug);
}
if (!item) return Astro.redirect('/404');

const title = item.title.rendered;
const content = item.content.rendered;
const mediaArray = item._embedded?.['wp:featuredmedia'];
const imageUrl = mediaArray && mediaArray.length > 0 ? mediaArray[0].source_url : '/placeholder-generic.jpg';
---

<MainLayout title={`${title} - UKM PBJT`}>
    <main class="min-h-screen bg-slate-50 pt-24 pb-16">
        
        <div class="relative bg-slate-900 py-24 mb-16 overflow-hidden">
            <div class="absolute inset-0 bg-blue-900/20"></div>
            <div class="relative max-w-4xl mx-auto px-4 text-center">
                <a href="/ukm" class="inline-flex items-center text-sm font-medium text-blue-300 hover:text-white mb-8 group">
                    <svg class="mr-2 h-4 w-4 transform group-hover:-translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
                    </svg>
                    Kembali ke Daftar UKM
                </a>
            </div>
        </div>

        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 -mt-32 relative z-10">
            <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-slate-100">
                <img src={imageUrl} alt={title} class="w-full h-64 md:h-96 object-cover bg-slate-100" />
                <div class="p-8 md:p-12">
                    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 mb-6" set:html={title}></h1>
                    <div class="prose prose-slate prose-lg max-w-none prose-a:text-blue-600 hover:prose-a:text-blue-500" set:html={content}></div>
                </div>
            </div>
        </div>
    </main>
</MainLayout>
