---
// mikrotik-academy.astro
---

<html lang="id">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>MikroTik Academy - Politeknik Baja Tegal</title>
</head>
<body class="bg-background text-text font-sans selection:bg-secondary selection:text-text">
    <style is:global>
        @keyframes scroll-text {
            0% { transform: translateX(100vw); }
            100% { transform: translateX(-100%); }
        }
        .ticker-animate {
            display: inline-block;
            white-space: nowrap;
            animation: scroll-text 25s linear infinite;
            will-change: transform;
        }
        .ticker-animate:hover {
            animation-play-state: paused;
        }
    </style>
    <!-- Top Announcement Ticker -->
    <div class="bg-primary-dark text-secondary-light text-base font-semibold py-3 overflow-hidden whitespace-nowrap relative z-[60] border-b border-primary/20">
        <div class="ticker-animate">
            <span class="inline-flex items-center gap-3 px-4">
                <span class="flex h-3 w-3 rounded-full bg-secondary animate-pulse shadow-[0_0_10px_rgba(245,158,11,1)]"></span>
                Pengumuman: Penerimaan Mahasiswa Baru Tahun Ajaran 2026/2027 Telah Resmi Dibuka! Segera Daftarkan Dirimu, Gelombang Pertama Ditutup Bulan Ini!
            </span>
        </div>
    </div>

    <!-- Navbar -->
    <nav class="bg-white/80 backdrop-blur-md sticky top-0 z-50 border-b border-slate-100 shadow-sm">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="flex justify-between items-center h-20">
                <a href="/" class="flex items-center gap-3 group">
                    <img src="/logo-pbjt-s.png" alt="Logo PBJT" class="h-10 w-auto group-hover:scale-105 transition-transform" />
                    <span class="font-bold text-xl text-primary-dark tracking-tight">Politeknik Baja Tegal</span>
                </a>
                <div class="hidden md:flex space-x-6 font-medium text-slate-600 items-center">
                    <a href="/" class="hover:text-primary transition-colors">Beranda</a>
                    
                    <!-- Dropdown Profil -->
                    <div class="relative group">
                        <button class="hover:text-primary transition-colors flex items-center gap-1">
                            Profil <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="absolute left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                            <div class="py-2 flex flex-col">
                                <a href="/tentang-pbjt" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Tentang PBJT</a>
                                <a href="/profil-politeknik-baja-tegal" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Profil Kampus</a>
                                <a href="/struktur-politeknik-baja-tegal" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Struktur Organisasi</a>
                                <a href="/biro" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">BIRO (BAAK)</a>
                                <a href="/akreditasi" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Akreditasi</a>
                            </div>
                        </div>
                    </div>

                    <!-- Dropdown Akademik -->
                    <div class="relative group">
                        <button class="text-primary transition-colors flex items-center gap-1 font-bold">
                            Akademik <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="absolute left-0 mt-2 w-60 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                            <div class="py-2 flex flex-col">
                                <a href="/program-studi" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Program Studi</a>
                                <a href="/d3-teknik-informatika" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">D3 Teknik Informatika</a>
                                <a href="/d3-teknik-mesin" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">D3 Teknik Mesin</a>
                                <a href="/d3-teknik-otomotif" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">D3 Teknik Otomotif</a>
                                <a href="/d3-teknik-elektronika-industri" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">D3 Teknik Elektronika</a>
                                <a href="/mikrotik-academy" class="px-4 py-2 bg-slate-50 text-primary font-semibold text-sm">Mikrotik Academy</a>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Dropdown Kemahasiswaan -->
                    <div class="relative group">
                        <button class="hover:text-primary transition-colors flex items-center gap-1">
                            Kemahasiswaan <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="absolute left-0 mt-2 w-56 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                            <div class="py-2 flex flex-col">
                                <a href="/bem" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">BEM</a>
                                <a href="/hmti" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">HMTI</a>
                                <a href="/rohis" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">ROHIS</a>
                                <a href="/racana" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">RACANA</a>
                                <a href="/bajapala" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">BAJAPALA</a>
                                <a href="/badminton" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">BADMINTON</a>
                                <a href="/futsal" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">FUTSAL</a>
                                <a href="/paduan-suara" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">PADUAN SUARA</a>
                                <a href="/forum-studi-ilmiah-fosil" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">FOSIL</a>
                            </div>
                        </div>
                    </div>

                    <!-- Dropdown PMB -->
                    <div class="relative group">
                        <button class="hover:text-primary transition-colors flex items-center gap-1">
                            PMB <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                        </button>
                        <div class="absolute left-0 mt-2 w-52 bg-white border border-slate-100 rounded-xl shadow-lg opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 z-50">
                            <div class="py-2 flex flex-col">
                                <a href="/pmb" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Info PMB</a>
                                <a href="/alur-pendaftaran" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Alur Pendaftaran</a>
                                <a href="/biaya-perkuliahan" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Biaya Perkuliahan</a>
                                <a href="/beasiswa-kip-kuliah" class="px-4 py-2 hover:bg-slate-50 hover:text-primary text-sm">Beasiswa KIP Kuliah</a>
                            </div>
                        </div>
                    </div>

                    <!-- Link Eksternal -->
                    <a href="https://siakad.pbjt.ac.id" target="_blank" rel="noopener" class="text-xs px-3 py-1.5 bg-primary/10 text-primary rounded-lg hover:bg-primary hover:text-white transition-all">Siakad ↗</a>
                    <a href="https://edlink.id/login" target="_blank" rel="noopener" class="text-xs px-3 py-1.5 bg-primary/10 text-primary rounded-lg hover:bg-primary hover:text-white transition-all">E-Learning ↗</a>
                </div>
            </div>
        </div>
    </nav>

    <main class="bg-slate-50 min-h-screen pb-20">
        
        <!-- Hero Section MikroTik -->
        <section class="relative bg-slate-900 overflow-hidden py-24">
            <div class="absolute inset-0 bg-primary-dark/20 mix-blend-multiply"></div>
            <div class="absolute top-0 right-0 w-[500px] h-[500px] bg-primary/20 rounded-full blur-[80px] -translate-y-1/2 translate-x-1/3 pointer-events-none"></div>
            
            <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center relative z-10">
                <span class="inline-block px-4 py-2 bg-secondary/20 text-secondary border border-secondary/30 rounded-full font-bold text-sm mb-6 uppercase tracking-wider backdrop-blur-sm">
                    Sertifikasi Internasional
                </span>
                <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-6">
                    <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-blue-200">MikroTik</span> Academy
                </h1>
                <p class="text-xl text-slate-300 max-w-2xl mx-auto mb-10 leading-relaxed">
                    D3 Teknik Informatika Politeknik Baja Tegal bekerja sama dengan MikroTik membuka kelas sertifikasi MTCNA berstandar internasional.
                </p>
                <div class="flex justify-center gap-4">
                    <a href="#jadwal" class="px-6 py-3 bg-secondary text-primary-dark font-bold rounded-xl shadow-lg shadow-secondary/30 hover:shadow-secondary/50 hover:-translate-y-1 transition-all">
                        Lihat Jadwal
                    </a>
                    <a href="#silabus" class="px-6 py-3 bg-white/10 text-white font-bold rounded-xl border border-white/20 hover:bg-white/20 hover:-translate-y-1 transition-all backdrop-blur-sm">
                        Unduh Silabus
                    </a>
                </div>
            </div>
        </section>

        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-16">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10">
                
                <!-- Kiri: Konten Utama -->
                <div class="lg:col-span-2 space-y-12">
                    
                    <div class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-slate-100">
                        <h2 class="text-3xl font-bold text-primary-dark mb-6">Tentang Program</h2>
                        <div class="prose prose-lg prose-slate prose-a:text-primary max-w-none">
                            <p>
                                <strong>MikroTik Academy</strong> adalah sebuah kelas yang akan memberikan pembelajaran mengenai dasar-dasar MikroTik dan dasar-dasar jaringan komputer. Kelas ini didesain khusus bagi mahasiswa Politeknik Baja Tegal yang teregister di semester yang sedang berjalan.
                            </p>
                            <p>
                                Pada akhir sesi kelas, mahasiswa berkesempatan untuk mengikuti ujian resmi <strong>MTCNA</strong> langsung dari <a href="https://mikrotik.com" target="_blank">mikrotik.com</a>. Peserta yang lulus ujian akan mendapatkan <strong>Sertifikat MTCNA yang diakui dan berlaku secara Internasional</strong>.
                            </p>
                        </div>
                        
                        <div class="mt-10 bg-slate-50 p-6 rounded-2xl border border-slate-100">
                            <h3 class="text-xl font-bold text-slate-800 mb-4">Materi MTCNA yang Diajarkan:</h3>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-slate-600">
                                <div class="flex items-start gap-2"><svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>Introduction to Mikrotik</span></div>
                                <div class="flex items-start gap-2"><svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>Instalasi & Pengoperasian (Winbox)</span></div>
                                <div class="flex items-start gap-2"><svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>Firewall Dasar</span></div>
                                <div class="flex items-start gap-2"><svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>Bridge System</span></div>
                                <div class="flex items-start gap-2"><svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>Static Routing</span></div>
                                <div class="flex items-start gap-2"><svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>Quality of Service (Simple)</span></div>
                                <div class="flex items-start gap-2"><svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>Wireless Concept</span></div>
                                <div class="flex items-start gap-2"><svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>Wireless Interface: PTP & PTMP</span></div>
                                <div class="flex items-start gap-2"><svg class="w-6 h-6 text-primary flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> <span>Praktikum Jaringan Dasar</span></div>
                            </div>
                        </div>
                    </div>

                    <div id="galeri" class="bg-white rounded-3xl p-8 md:p-12 shadow-sm border border-slate-100">
                        <h2 class="text-3xl font-bold text-primary-dark mb-8">Galeri Training MikroTik</h2>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-4">
                            <img src="https://pbjt.ac.id/wp-content/uploads/2025/02/10-1024x1024.png" alt="Galeri 1" class="w-full aspect-square object-cover rounded-2xl hover:scale-105 transition-transform duration-300 shadow-sm border border-slate-100 cursor-pointer" onerror="this.src='/placeholder.jpg'"/>
                            <img src="https://pbjt.ac.id/wp-content/uploads/2025/02/9-1024x1024.png" alt="Galeri 2" class="w-full aspect-square object-cover rounded-2xl hover:scale-105 transition-transform duration-300 shadow-sm border border-slate-100 cursor-pointer" onerror="this.src='/placeholder.jpg'"/>
                            <img src="https://pbjt.ac.id/wp-content/uploads/2025/02/8-1024x1024.png" alt="Galeri 3" class="w-full aspect-square object-cover rounded-2xl hover:scale-105 transition-transform duration-300 shadow-sm border border-slate-100 cursor-pointer" onerror="this.src='/placeholder.jpg'"/>
                            <img src="https://pbjt.ac.id/wp-content/uploads/2025/02/7-1024x1024.png" alt="Galeri 4" class="w-full aspect-square object-cover rounded-2xl hover:scale-105 transition-transform duration-300 shadow-sm border border-slate-100 cursor-pointer" onerror="this.src='/placeholder.jpg'"/>
                            <img src="https://pbjt.ac.id/wp-content/uploads/2025/02/5-1024x1024.png" alt="Galeri 5" class="w-full aspect-square object-cover rounded-2xl hover:scale-105 transition-transform duration-300 shadow-sm border border-slate-100 cursor-pointer" onerror="this.src='/placeholder.jpg'"/>
                            <img src="https://pbjt.ac.id/wp-content/uploads/2025/02/4-1024x1024.png" alt="Galeri 6" class="w-full aspect-square object-cover rounded-2xl hover:scale-105 transition-transform duration-300 shadow-sm border border-slate-100 cursor-pointer" onerror="this.src='/placeholder.jpg'"/>
                            <img src="https://pbjt.ac.id/wp-content/uploads/2025/02/3-1024x1024.png" alt="Galeri 7" class="w-full aspect-square object-cover rounded-2xl hover:scale-105 transition-transform duration-300 shadow-sm border border-slate-100 cursor-pointer" onerror="this.src='/placeholder.jpg'"/>
                            <img src="https://pbjt.ac.id/wp-content/uploads/2025/02/2-1024x1024.png" alt="Galeri 8" class="w-full aspect-square object-cover rounded-2xl hover:scale-105 transition-transform duration-300 shadow-sm border border-slate-100 cursor-pointer" onerror="this.src='/placeholder.jpg'"/>
                            <img src="https://pbjt.ac.id/wp-content/uploads/2025/02/1-1024x1024.png" alt="Galeri 9" class="w-full aspect-square object-cover rounded-2xl hover:scale-105 transition-transform duration-300 shadow-sm border border-slate-100 cursor-pointer" onerror="this.src='/placeholder.jpg'"/>
                        </div>
                    </div>
                </div>

                <!-- Kanan: Sidebar Informasi -->
                <div class="space-y-8">
                    
                    <div id="jadwal" class="bg-primary text-white rounded-3xl p-8 shadow-lg relative overflow-hidden">
                        <div class="absolute top-0 right-0 w-32 h-32 bg-white/10 rounded-full blur-2xl -translate-y-1/2 translate-x-1/2"></div>
                        <h3 class="text-xl font-bold mb-6 flex items-center gap-2">
                            <svg class="w-6 h-6 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
                            Jadwal Pelaksanaan
                        </h3>
                        
                        <div class="space-y-4">
                            <div class="bg-black/20 p-4 rounded-xl border border-white/10">
                                <p class="text-white/60 text-sm mb-1 uppercase tracking-wider font-semibold">Tanggal</p>
                                <p class="font-bold text-lg">30 Sept - 1 Okt 2025</p>
                            </div>
                            <div class="bg-black/20 p-4 rounded-xl border border-white/10">
                                <p class="text-white/60 text-sm mb-1 uppercase tracking-wider font-semibold">Waktu</p>
                                <p class="font-bold text-lg">08:00 - 13:00 WIB</p>
                            </div>
                            <div class="bg-black/20 p-4 rounded-xl border border-white/10">
                                <p class="text-white/60 text-sm mb-1 uppercase tracking-wider font-semibold">Tempat</p>
                                <p class="font-bold text-lg">Lab TI Politeknik Baja Tegal</p>
                            </div>
                        </div>

                        <div class="mt-8 pt-6 border-t border-white/20">
                            <h4 class="font-bold mb-3">Persyaratan Perangkat:</h4>
                            <ul class="space-y-2 text-sm text-white/90">
                                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Laptop WiFi Ready</li>
                                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 10/100 Ethernet Port Ready</li>
                                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> 2 Kabel UTP Cat5 (2 meter)</li>
                                <li class="flex items-center gap-2"><svg class="w-4 h-4 text-secondary" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> OS Windows XP / Terbaru</li>
                            </ul>
                        </div>
                    </div>

                    <div id="silabus" class="bg-white rounded-3xl p-8 border border-slate-200 shadow-sm text-center">
                        <div class="w-16 h-16 bg-red-100 text-red-600 rounded-2xl flex items-center justify-center mx-auto mb-4">
                            <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                        </div>
                        <h3 class="font-bold text-xl text-slate-800 mb-2">Silabus Resmi</h3>
                        <p class="text-sm text-slate-500 mb-6">Unduh dan pelajari silabus sertifikasi MikroTik Academy MTCNA</p>
                        <a href="https://pbjt.ac.id/wp-content/uploads/2025/02/MikroTikAcademy_EN.pdf" target="_blank" download class="block w-full py-3 px-4 bg-slate-900 text-white font-semibold rounded-xl hover:bg-primary transition-colors text-center">
                            Unduh PDF
                        </a>
                    </div>

                    <div class="bg-secondary/10 rounded-3xl p-8 border border-secondary/20">
                        <h3 class="font-bold text-xl text-slate-800 mb-2">Cara Mendaftar</h3>
                        <p class="text-slate-600 mb-4">
                            Pendaftaran dan Pembayaran bisa dilakukan secara langsung melalui <strong>Sekretaris Prodi Teknik Informatika</strong>.
                        </p>
                    </div>

                </div>

            </div>
        </div>
    </main>

    <!-- Footer -->
    <footer class="bg-slate-900 text-slate-400 py-16 border-t border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-12">
                <!-- Col 1 -->
                <div>
                    <div class="flex items-center gap-3 mb-6">
                        <img src="/logo-pbjt-s.png" alt="Logo PBJT" class="h-12 w-auto bg-white/10 p-1 rounded-lg" />
                        <span class="text-xl font-bold text-white">Politeknik Baja Tegal</span>
                    </div>
                    <p class="text-sm text-slate-400 mb-6 leading-relaxed">
                        Kampus vokasi modern yang mencetak SDM unggul, profesional, dan berdaya saing global di era industri digital.
                    </p>
                    <div class="text-sm">
                        <p class="mb-2"><strong class="text-slate-300">📍 Alamat:</strong><br/>Jl. Raya Tegal-Slawi, Jawa Tengah</p>
                    </div>
                </div>

                <!-- Col 2 -->
                <div>
                    <h3 class="text-white font-bold mb-6 uppercase tracking-wider text-sm">Profil & Akademik</h3>
                    <ul class="space-y-3 text-sm">
                        <li><a href="/tentang-pbjt" class="hover:text-primary transition-colors">Tentang PBJT</a></li>
