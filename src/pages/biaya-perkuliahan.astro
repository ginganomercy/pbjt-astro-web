---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Biaya Perkuliahan - Politeknik Baja Tegal">
    <main class="bg-slate-50 min-h-screen py-16">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <header class="text-center mb-12">
                <a href="/pmb" class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors mb-6 group">
                    <svg class="w-4 h-4 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali ke Info PMB
                </a>
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">Rincian Biaya Perkuliahan</h1>
                <p class="text-xl text-slate-500">Transparan, Terjangkau, dan Berkualitas</p>
            </header>

            <!-- Skeleton Loader -->
            <div id="biaya-skeleton" class="w-full h-[600px] bg-slate-200 rounded-[2.5rem] animate-pulse"></div>

            <!-- Kontainer Biaya (Invoice Style) -->
            <div id="biaya-container" class="hidden relative bg-white rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-slate-100 overflow-hidden">
                
                <!-- Dekorasi Atas -->
                <div class="h-4 w-full bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400"></div>
                <div class="absolute top-0 right-0 w-64 h-64 bg-slate-50 rounded-full -translate-y-1/2 translate-x-1/2 opacity-50 pointer-events-none"></div>

                <!-- Konten Biaya -->
                <div class="p-8 md:p-12 relative z-10">
                    <div id="biaya-content" class="biaya-prose max-w-none">
                        <!-- Raw WordPress HTML goes here, styled by CSS below -->
                    </div>
                </div>
                
                <!-- Bawah -->
                <div class="bg-slate-50 p-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                    <p class="text-slate-500 text-sm">Masih punya pertanyaan terkait biaya?</p>
                    <a href="https://wa.me/6281234567890" target="_blank" class="px-6 py-3 bg-blue-100 text-blue-700 font-bold rounded-xl hover:bg-blue-200 transition-colors flex items-center gap-2">
                        Hubungi Bagian Keuangan
                    </a>
                </div>
            </div>

            <!-- Error State -->
            <div id="biaya-error" class="hidden text-center py-20 bg-red-50 rounded-3xl border border-red-100 mt-8">
                <h3 class="text-2xl font-bold text-red-500 mb-2">Gagal Memuat Informasi</h3>
                <p class="text-slate-600">Terjadi kesalahan saat menarik data biaya dari server.</p>
            </div>

        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const skeleton = document.getElementById('biaya-skeleton');
            const container = document.getElementById('biaya-container');
            const content = document.getElementById('biaya-content');
            const errorEl = document.getElementById('biaya-error');

            try {
                const response = await fetch('https://wp.pbjt.ac.id/wp-json/wp/v2/pages?_embed&slug=biaya-perkuliahan');
                if (!response.ok) throw new Error('API Error');
                
                const pages = await response.json();
                if (pages.length === 0) throw new Error('Page not found');
                
                const page = pages[0];
                content.innerHTML = page.content.rendered;

                skeleton.classList.add('hidden');
                container.classList.remove('hidden');
                container.classList.add('animate-[fadeIn_0.5s_ease-out_forwards]');

            } catch (e) {
                console.error(e);
                skeleton.classList.add('hidden');
                errorEl.classList.remove('hidden');
            }
        });
    </script>

    <style is:global>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* CUSTOM BIAYA PROSE OVERRIDE */
        .biaya-prose {
            font-family: inherit;
        }
        
        /* H2 Main Titles */
        .biaya-prose h2 {
            font-size: 1.5rem;
            font-weight: 800;
            color: #0f172a !important; /* Force slate-900 */
            text-align: left !important;
            margin-bottom: 2rem;
            padding-bottom: 1rem;
            border-bottom: 2px solid #f1f5f9;
        }

        /* H3 / Paragraph acting as Section Titles */
        .biaya-prose p strong {
            display: inline-block;
            font-size: 1.25rem;
            color: #1e40af !important; /* Force blue-800 */
            margin-top: 1.5rem;
            margin-bottom: 0.5rem;
            background: #eff6ff;
            padding: 0.5rem 1rem;
            border-radius: 0.5rem;
        }

        /* Ordered Lists (The items) */
        .biaya-prose ol {
            list-style: none;
            counter-reset: biaya-counter;
            padding-left: 0;
            margin-bottom: 2rem;
        }

        .biaya-prose ol > li {
            position: relative;
            padding-left: 2.5rem;
            margin-bottom: 1rem;
            font-size: 1.125rem;
            font-weight: 600;
            color: #334155;
            background: #f8fafc;
            padding: 1rem 1rem 1rem 3rem;
            border-radius: 1rem;
            border: 1px solid #f1f5f9;
        }

        .biaya-prose ol > li::before {
            counter-increment: biaya-counter;
            content: counter(biaya-counter);
            position: absolute;
            left: 1rem;
            top: 1rem;
            width: 1.5rem;
            height: 1.5rem;
            background: #3b82f6;
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
            font-weight: bold;
        }

        /* Nested Unordered Lists (The details/installments) */
        .biaya-prose ul {
            list-style: none;
            padding-left: 0;
            margin-top: 0.75rem;
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
        }

        .biaya-prose ul > li {
            font-size: 1rem;
            font-weight: 400;
            color: #64748b !important;
            padding-left: 1.5rem;
            position: relative;
        }

        .biaya-prose ul > li::before {
            content: "•";
            position: absolute;
            left: 0;
            color: #94a3b8;
        }

        /* Highlight specific lines from WordPress colors */
        .biaya-prose .has-vivid-cyan-blue-color {
            color: #0284c7 !important;
            font-style: italic;
            background: #f0f9ff;
            padding: 0.25rem 0.5rem;
            border-radius: 0.25rem;
            display: inline-block;
            margin-top: 0.25rem;
        }

        .biaya-prose .has-vivid-red-color {
            color: #ef4444 !important;
            background: #fef2f2;
            padding: 1rem;
            border-radius: 0.5rem;
            border-left: 4px solid #ef4444;
            font-size: 0.875rem;
            margin-top: 2rem;
        }
        
        /* General Paragraphs at the bottom */
        .biaya-prose > p:last-child, .biaya-prose > p:nth-last-child(2) {
            font-size: 1rem;
            color: #475569 !important;
            line-height: 1.6;
        }
    </style>
</MainLayout>
