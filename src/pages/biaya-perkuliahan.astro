---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Biaya Perkuliahan - Politeknik Baja Tegal">
    <main class="bg-slate-50 min-h-screen py-16">
        <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <header class="text-center mb-12">
                <a href="/pmb" class="inline-flex items-center text-sm font-medium text-blue-600 hover:text-blue-800 transition-colors mb-6 group">
                    <svg class="w-4 h-4 mr-2 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Kembali ke Info PMB
                </a>
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 mb-4 tracking-tight">Rincian Biaya Kuliah</h1>
                <p class="text-xl text-slate-500">Tahun Akademik 2026/2027</p>
            </header>

            <!-- Kontainer Biaya -->
            <div id="biaya-container" class="relative bg-white rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.05)] border border-slate-100 overflow-hidden animate-[fadeIn_0.5s_ease-out_forwards]">
                
                <!-- Dekorasi Atas -->
                <div class="h-4 w-full bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400"></div>
                <div class="absolute top-0 right-0 w-64 h-64 bg-slate-50 rounded-full -translate-y-1/2 translate-x-1/2 opacity-50 pointer-events-none"></div>

                <!-- Konten Biaya -->
                <div class="p-8 md:p-12 relative z-10 flex flex-col gap-6">
                    
                    <div class="bg-blue-50/50 rounded-3xl p-6 md:p-8 border border-blue-100 flex flex-col md:flex-row justify-between items-center gap-6">
                        <div class="flex items-center gap-4">
                            <div class="w-14 h-14 bg-white rounded-2xl shadow-sm flex items-center justify-center shrink-0 border border-blue-100">
                                <span class="text-2xl font-bold text-blue-600">1</span>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-slate-800">Biaya Registrasi</h3>
                                <p class="text-slate-500 text-sm">Pendaftaran awal mahasiswa baru.</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-2xl font-extrabold text-slate-800">Rp 200.000</span>
                        </div>
                    </div>

                    <div class="bg-blue-50/50 rounded-3xl p-6 md:p-8 border border-blue-100 flex flex-col md:flex-row justify-between items-center gap-6">
                        <div class="flex items-center gap-4">
                            <div class="w-14 h-14 bg-white rounded-2xl shadow-sm flex items-center justify-center shrink-0 border border-blue-100">
                                <span class="text-2xl font-bold text-blue-600">2</span>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-slate-800">Daftar Ulang</h3>
                                <p class="text-slate-500 text-sm">Minimum pembayaran di awal masuk.</p>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-2xl font-extrabold text-slate-800">Rp 3.000.000</span>
                        </div>
                    </div>

                    <div class="bg-gradient-to-br from-blue-600 to-indigo-700 rounded-3xl p-6 md:p-8 shadow-xl shadow-blue-900/20 text-white flex flex-col md:flex-row justify-between items-center gap-6 relative overflow-hidden">
                        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10"></div>
                        <div class="flex items-center gap-4 relative z-10">
                            <div class="w-14 h-14 bg-white/10 rounded-2xl flex items-center justify-center shrink-0 border border-white/20 backdrop-blur-sm">
                                <span class="text-2xl font-bold text-white">3</span>
                            </div>
                            <div>
                                <h3 class="text-xl font-bold text-white">UKT (Uang Kuliah Tunggal)</h3>
                                <p class="text-blue-100 text-sm max-w-sm">Berlaku untuk semua program studi tiap semesternya.</p>
                            </div>
                        </div>
                        <div class="text-right relative z-10">
                            <span class="text-3xl font-extrabold text-white">Rp 5.550.000</span>
                            <p class="text-blue-200 text-sm mt-1">/ Tiap Semester</p>
                        </div>
                    </div>

                    <!-- Alert Note -->
                    <div class="mt-4 bg-orange-50 rounded-2xl p-6 border border-orange-100 flex items-start gap-4">
                        <svg class="w-6 h-6 text-orange-500 shrink-0 mt-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        <div>
                            <h4 class="font-bold text-orange-800 mb-1">Catatan Penting</h4>
                            <p class="text-orange-700/80 text-sm leading-relaxed">
                                Biaya UKT sudah berstatus bersih (all-in). Nominal tersebut <strong>sudah termasuk</strong> biaya Sumbangan Pengembangan Institusi (SPI), kegiatan LDK (Latihan Dasar Kepemimpinan), KKL (Kuliah Kerja Lapangan), Magang, TA (Tugas Akhir), dan Wisuda.
                            </p>
                        </div>
                    </div>

                </div>
                
                <!-- Bawah (Kontak) -->
                <div class="bg-slate-50 p-8 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-6">
                    <div>
                        <h4 class="font-bold text-slate-800 mb-1">Informasi Pembayaran</h4>
                        <p class="text-slate-500 text-sm leading-relaxed max-w-lg">Pembayaran dapat dilakukan melalui Transfer Bank Nasional, Bank Daerah, maupun Virtual Account (VA). Silakan hubungi Bagian Keuangan (Ibu Ismi) untuk mendapatkan nomor rekening / VA resmi Politeknik Baja Tegal.</p>
                    </div>
                    <a href="https://wa.me/6285742820993" target="_blank" class="px-6 py-4 bg-[#25D366] hover:bg-[#128C7E] text-white font-bold rounded-xl transition-all shadow-lg shadow-green-500/30 hover:shadow-green-500/50 hover:-translate-y-1 flex items-center gap-3 shrink-0">
                        <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24"><path d="M12.031 0C5.385 0 0 5.385 0 12.031c0 2.124.551 4.135 1.517 5.918L.003 24l6.22-1.633a11.968 11.968 0 005.808 1.495h.005c6.645 0 12.031-5.386 12.031-12.031C24.062 5.385 18.676 0 12.031 0zm0 21.84c-1.782 0-3.535-.48-5.068-1.39l-.364-.216-3.766.988.998-3.67-.236-.375A9.976 9.976 0 012.052 12.03c0-5.512 4.485-9.997 9.98-9.997 2.671 0 5.184 1.04 7.07 2.928 1.888 1.888 2.928 4.4 2.928 7.07 0 5.51-4.486 9.998-9.998 9.998z"/></svg>
                        Hubungi Ibu Ismi
                    </a>
                </div>
            </div>

        </div>
    </main>

    <style is:global>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</MainLayout>
