---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Profil Politeknik Baja Tegal">
    
    <!-- Hero Banner Premium -->
    <section class="relative pt-32 pb-24 lg:pt-40 lg:pb-32 overflow-hidden bg-slate-900">
        <!-- Abstract Background -->
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute -top-[20%] -right-[10%] w-[50%] h-[50%] rounded-full bg-blue-600/20 blur-[120px]"></div>
            <div class="absolute bottom-[10%] -left-[10%] w-[40%] h-[40%] rounded-full bg-cyan-500/20 blur-[100px]"></div>
            <div class="absolute inset-0 bg-[url('/grid-pattern.svg')] opacity-10"></div>
        </div>
        
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
            <span class="inline-block py-1 px-3 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30 font-semibold text-sm tracking-wider mb-6">TENTANG KAMPUS</span>
            <h1 class="text-4xl md:text-5xl lg:text-7xl font-extrabold text-white mb-6 tracking-tight leading-tight">
                Profil Politeknik <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 to-cyan-300">Baja Tegal</span>
            </h1>
            <p class="text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed">
                Menjadi Pendidikan Tinggi Vokasi untuk menghasilkan lulusan yang beriman, bertaqwa, trampil, beretos kerja tinggi dan berdaya saing global.
            </p>
        </div>
    </section>

    <!-- Elevated Content Area -->
    <main class="relative bg-slate-50 min-h-screen pb-24 -mt-12">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20">
            
            <!-- Skeleton Loader -->
            <div id="profil-skeleton" class="w-full bg-white rounded-3xl p-8 md:p-16 shadow-[0_10px_40px_-15px_rgba(0,0,0,0.1)] mb-12">
                <div class="h-8 bg-slate-200 rounded w-1/3 mb-10 animate-pulse"></div>
                <div class="space-y-4 mb-12">
                    <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                    <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                    <div class="h-4 bg-slate-200 rounded w-5/6 animate-pulse"></div>
                </div>
                <div class="h-8 bg-slate-200 rounded w-1/4 mb-10 animate-pulse"></div>
                <div class="space-y-4">
                    <div class="h-4 bg-slate-200 rounded w-full animate-pulse"></div>
                    <div class="h-4 bg-slate-200 rounded w-4/5 animate-pulse"></div>
                </div>
            </div>

            <!-- Content Container -->
            <div id="profil-container" class="hidden w-full bg-white rounded-3xl p-6 md:p-12 lg:p-16 shadow-[0_20px_50px_-15px_rgba(0,0,0,0.05)] border border-slate-100">
                <div id="profil-content" class="profil-custom-prose max-w-none">
                    <!-- Data dari WordPress API akan disuntikkan ke sini -->
                </div>
            </div>

            <!-- Error State -->
            <div id="profil-error" class="hidden text-center py-20 bg-red-50 rounded-3xl border border-red-100 shadow-sm">
                <svg class="w-16 h-16 text-red-400 mx-auto mb-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
                <h3 class="text-2xl font-bold text-red-600 mb-2">Oops! Gagal Memuat Data</h3>
                <p class="text-red-500/80">Koneksi ke server kampus terputus atau halaman belum tersedia.</p>
            </div>

        </div>
    </main>

    <!-- Script Fetch API -->
    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const skeleton = document.getElementById('profil-skeleton');
            const container = document.getElementById('profil-container');
            const content = document.getElementById('profil-content');
            const errorEl = document.getElementById('profil-error');

            try {
                const response = await fetch('https://wp.pbjt.ac.id/wp-json/wp/v2/pages?_embed&slug=profil-politeknik-baja-tegal');
                if (!response.ok) throw new Error('Network response was not ok');
                
                const pages = await response.json();
                if (pages.length === 0) throw new Error('Page not found');
                
                const page = pages[0];
                let rawHtml = page.content.rendered;
                
                // Hilangkan tag H1 ganda jika pengguna telanjur mengetik judul di dalam konten
                rawHtml = rawHtml.replace(/<h1[^>]*>.*?<\/h1>/gi, '');
                
                // FIX TEKS TEMBUS: Ganti Non-Breaking Space (&nbsp;) dengan spasi biasa
                // WordPress kadang menghasilkan &nbsp; berantai yang membuat teks dianggap sebagai satu kata super panjang sehingga menabrak batas layar.
                rawHtml = rawHtml.replace(/&nbsp;/g, ' ');
                
                content.innerHTML = rawHtml;

                // Animasi masuk
                skeleton.classList.add('hidden');
                container.classList.remove('hidden');
                container.classList.add('animate-[fadeInUp_0.6s_ease-out_forwards]');

            } catch (error) {
                console.error('Error fetching profil:', error);
                skeleton.classList.add('hidden');
                errorEl.classList.remove('hidden');
            }
        });
    </script>

    <!-- CSS Override Premium untuk WordPress HTML -->
    <style is:global>
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(30px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* 
        ==================================================
        PROFIL CUSTOM PROSE - DANDANAN HTML WORDPRESS
        ================================================== 
        */
        .profil-custom-prose {
            font-family: inherit;
            color: #334155;
            line-height: 1.8;
            font-size: 1.125rem;
            overflow-wrap: break-word;
            word-wrap: break-word;
        }

        /* ----- HEADINGS (H2, H3) ----- */
        .profil-custom-prose h2 {
            font-size: 2rem;
            font-weight: 800;
            color: #0f172a !important; /* Timpa style warna bawaan WP */
            text-align: left !important;
            margin-top: 3.5rem;
            margin-bottom: 1.5rem;
            position: relative;
            padding-bottom: 1rem;
        }
        
        /* Garis bawah biru elegan untuk H2 */
        .profil-custom-prose h2::after {
            content: '';
            position: absolute;
            left: 0;
            bottom: 0;
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, #2563eb, #06b6d4);
            border-radius: 2px;
        }

        .profil-custom-prose h3 {
            font-size: 1.5rem;
            font-weight: 700;
            color: #1e293b;
            margin-top: 2.5rem;
            margin-bottom: 1rem;
        }

        /* ----- PARAGRAPHS ----- */
        .profil-custom-prose p {
            margin-bottom: 1.5rem;
            text-align: justify;
        }

        /* Menyoroti paragraf pertama sebagai Lead/Intro */
        .profil-custom-prose > p:first-of-type {
            font-size: 1.25rem;
            color: #475569;
            line-height: 1.9;
            font-weight: 500;
        }

        /* ----- LISTS (Visi, Misi, Tujuan) ----- */
        .profil-custom-prose ul {
            list-style: none;
            padding-left: 0;
            margin-top: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .profil-custom-prose ul > li {
            position: relative;
            padding-left: 2rem;
            margin-bottom: 1rem;
            background: #f8fafc;
            padding: 1rem 1rem 1rem 3rem;
            border-radius: 0.75rem;
            border: 1px solid #f1f5f9;
            transition: all 0.3s ease;
        }
        
        .profil-custom-prose ul > li:hover {
            background: #fff;
            border-color: #bfdbfe;
            box-shadow: 0 4px 6px -1px rgba(59, 130, 246, 0.1);
        }

        /* Ikon Centang Custom untuk Bullet */
        .profil-custom-prose ul > li::before {
            content: "✓";
            position: absolute;
            left: 1rem;
            top: 1.1rem;
            color: #3b82f6;
            font-weight: 900;
        }

        .profil-custom-prose ol {
            list-style: none;
            counter-reset: custom-counter;
            padding-left: 0;
            margin-top: 1.5rem;
            margin-bottom: 2.5rem;
        }

        .profil-custom-prose ol > li {
            position: relative;
            padding-left: 3.5rem;
            margin-bottom: 1rem;
            background: #ffffff;
            padding: 1.25rem 1.25rem 1.25rem 4rem;
            border-radius: 1rem;
            border: 1px solid #e2e8f0;
            box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
        }
        
        .profil-custom-prose ol > li:hover {
            border-color: #93c5fd;
            box-shadow: 0 10px 15px -3px rgba(59, 130, 246, 0.1);
            transform: translateY(-2px);
        }

        /* Angka di dalam lingkaran biru (Badge) */
        .profil-custom-prose ol > li::before {
            counter-increment: custom-counter;
            content: counter(custom-counter);
            position: absolute;
            left: 1.25rem;
            top: 1.25rem;
            width: 2rem;
            height: 2rem;
            background: linear-gradient(135deg, #2563eb, #3b82f6);
            color: white;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 0.875rem;
            font-weight: 800;
            box-shadow: 0 4px 6px -1px rgba(37, 99, 235, 0.3);
        }

        /* ----- TABEL (Struktur Yayasan dll) ----- */
        .profil-custom-prose figure.wp-block-table {
            margin: 3rem 0;
            overflow-x: auto;
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            border: 1px solid #e2e8f0;
        }

        .profil-custom-prose table {
            width: 100%;
            border-collapse: collapse;
            text-align: left;
            background: #ffffff;
            min-width: 600px;
        }

        .profil-custom-prose th,
        .profil-custom-prose td {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid #f1f5f9;
        }

        /* Gaya Khusus Header Tabel jika ada */
        .profil-custom-prose thead th {
            background-color: #f8fafc;
            font-weight: 700;
            color: #1e293b;
            text-transform: uppercase;
            font-size: 0.875rem;
            letter-spacing: 0.05em;
        }

        /* Zebra striping untuk Baris */
        .profil-custom-prose tbody tr:nth-child(even) {
            background-color: #f8fafc;
        }
        
        .profil-custom-prose tbody tr:hover {
            background-color: #f0f9ff;
        }

        .profil-custom-prose td:first-child {
            font-weight: 600;
            color: #0f172a;
            width: 25%;
        }

        /* ----- SEPARATOR (HR) ----- */
        .profil-custom-prose hr {
            display: none; /* Sembunyikan garis bawaan WP karena H2 kita sudah punya garis bawah */
        }
        
        .profil-custom-prose .wp-block-spacer {
            height: 2rem !important; /* Normalisasi spacer raksasa dari WP */
        }
        
        /* Highlight teks penting / bold */
        .profil-custom-prose strong {
            color: #0f172a;
            font-weight: 700;
        }
    </style>
</MainLayout>
