---
import MainLayout from '../layouts/MainLayout.astro';

const pimpinan = [
    {
        jabatan: "Direktur",
        nama: "Slamet Riyadi, S.T., M.T.",
        slug: "slamet-riyadi-m-t",
        foto: "/image/foto-dosen/slamet-riyadi-m-t.webp",
        roleDesc: "Pimpinan tertinggi pelaksana akademik dan tata kelola institusi Politeknik Baja Tegal.",
        badgeColor: "bg-blue-600 text-white",
        highlight: true,
    },
    {
        jabatan: "Wakil Direktur 1",
        nama: "Aziz Azindani, M.Kom",
        slug: "aziz-azindani-m-kom",
        foto: "/image/foto-dosen/aziz-azindani-m-kom.webp",
        bidang: "Bidang Akademik & Kurikulum",
        roleDesc: "Mengoordinasikan kegiatan akademik, pengembangan kurikulum, dan proses pembelajaran.",
        badgeColor: "bg-cyan-600 text-white",
    },
    {
        jabatan: "Wakil Direktur 2",
        nama: "Lily Budinurani, M.Pd.",
        slug: "lily-budinurani-m-pd",
        foto: "/image/foto-dosen/lily-budinurani-m-pd.webp",
        bidang: "Bidang Umum, Keuangan & Kepegawaian",
        roleDesc: "Mengoordinasikan administrasi umum, sarana prasarana, keuangan, dan SDM.",
        badgeColor: "bg-teal-600 text-white",
    },
    {
        jabatan: "Wakil Direktur 3",
        nama: "Ria Candra Dewi, M.Pd.",
        slug: "ria-candra-dewi",
        foto: "/image/foto-dosen/ria-candra-dewi.webp",
        bidang: "Bidang Kemahasiswaan & Kerjasama",
        roleDesc: "Mengoordinasikan kegiatan pembinaan mahasiswa, alumni, dan kerjasama industri.",
        badgeColor: "bg-indigo-600 text-white",
    }
];
---

<MainLayout title="Struktur Politeknik Baja Tegal - Jajaran Pimpinan & Bagan Organisasi">
    
    <!-- Hero Banner -->
    <section class="relative pt-32 pb-24 lg:pt-36 lg:pb-28 overflow-hidden bg-slate-900">
        <div class="absolute inset-0 overflow-hidden pointer-events-none">
            <div class="absolute -top-[20%] -right-[10%] w-[50%] h-[50%] rounded-full bg-blue-600/20 blur-[120px]"></div>
            <div class="absolute bottom-[10%] -left-[10%] w-[40%] h-[40%] rounded-full bg-indigo-500/15 blur-[100px]"></div>
            <div class="absolute inset-0 bg-[radial-gradient(#6366f1_1px,transparent_1px)] [background-size:24px_24px] opacity-10"></div>
        </div>
        
        <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center z-10">
            <span class="inline-flex items-center gap-2 py-1.5 px-4 rounded-full bg-blue-500/20 text-blue-300 border border-blue-400/30 font-semibold text-xs md:text-sm tracking-wider uppercase mb-6 backdrop-blur-sm">
                <span class="w-2 h-2 rounded-full bg-cyan-400 animate-pulse"></span>
                Tata Kelola & Kepemimpinan
            </span>
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-white mb-6 tracking-tight leading-tight">
                Struktur Organisasi <span class="text-transparent bg-clip-text bg-gradient-to-r from-blue-400 via-cyan-300 to-indigo-300">Politeknik Baja Tegal</span>
            </h1>
            <p class="text-lg md:text-xl text-slate-300 max-w-3xl mx-auto leading-relaxed font-light">
                Jajaran pimpinan yang berdedikasi mewujudkan pendidikan tinggi vokasi unggul, profesional, dan berdaya saing global di era industri modern.
            </p>
        </div>
    </section>

    <!-- Content Area -->
    <main class="relative bg-slate-50 min-h-screen py-16 -mt-8">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Breadcrumbs -->
            <nav class="flex text-sm text-slate-500 mb-10" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/" class="hover:text-primary transition-colors flex items-center gap-1.5 font-medium">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/></svg>
                            Beranda
                        </a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-slate-400 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                            <span class="text-slate-400">Profil</span>
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-slate-400 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
                            <span class="text-slate-800 font-semibold">Struktur Organisasi</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <!-- SECTION 1: JAJARAN PIMPINAN (Teks Asli: Direktur & Wadir 1, 2, 3) -->
            <section class="mb-20">
                <div class="text-center max-w-3xl mx-auto mb-12">
                    <span class="text-xs font-extrabold uppercase tracking-widest text-primary bg-primary/10 px-3 py-1 rounded-full border border-primary/20">Executive Board</span>
                    <h2 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mt-3">
                        Pimpinan Politeknik Baja Tegal
                    </h2>
                    <div class="w-16 h-1 bg-gradient-to-r from-blue-600 to-cyan-500 mx-auto mt-4 rounded-full"></div>
                </div>

                <!-- DIREKTUR (Puncak Struktur) -->
                <div class="max-w-md mx-auto mb-12">
                    <div class="group bg-white rounded-3xl p-6 md:p-8 shadow-[0_10px_40px_rgb(0,0,0,0.06)] border border-slate-100 hover:border-blue-400 hover:shadow-xl transition-all duration-300 text-center relative overflow-hidden">
                        <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-r from-blue-600 to-indigo-600"></div>
                        
                        <div class="relative w-36 h-36 md:w-44 md:h-44 mx-auto mb-6">
                            <div class="absolute inset-0 rounded-full bg-gradient-to-tr from-blue-600 to-indigo-500 blur-md opacity-20 group-hover:opacity-40 transition-opacity"></div>
                            <img 
                                src={pimpinan[0].foto} 
                                alt={pimpinan[0].nama}
                                onerror="this.onerror=null; this.src='/image/foto-dosen/default-avatar.svg';"
                                class="relative w-full h-full object-cover rounded-full border-4 border-white shadow-md group-hover:scale-105 transition-transform duration-300" 
                            />
                        </div>

                        <span class="inline-block py-1 px-4 rounded-full text-xs font-extrabold uppercase tracking-wider bg-blue-600 text-white shadow-sm mb-3">
                            {pimpinan[0].jabatan}
                        </span>

                        <h3 class="text-xl md:text-2xl font-extrabold text-slate-900 group-hover:text-blue-600 transition-colors">
                            {pimpinan[0].nama}
                        </h3>

                        <p class="text-slate-500 text-sm mt-3 leading-relaxed">
                            {pimpinan[0].roleDesc}
                        </p>

                        <div class="mt-6 pt-5 border-t border-slate-100">
                            <a 
                                href={`/dosen/${pimpinan[0].slug}`} 
                                class="inline-flex items-center gap-2 text-xs font-bold text-blue-600 hover:text-blue-800 uppercase tracking-wider group-hover:translate-x-1 transition-all"
                            >
                                <span>Lihat Profil Dosen</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                            </a>
                        </div>
                    </div>
                </div>

                <!-- 3 WAKIL DIREKTUR (Grid Sejajar) -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
                    {pimpinan.slice(1).map((wadir) => (
                        <div class="group bg-white rounded-3xl p-6 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 hover:border-slate-300 hover:shadow-xl transition-all duration-300 text-center flex flex-col justify-between">
                            <div>
                                <div class="relative w-32 h-32 mx-auto mb-5">
                                    <div class="absolute inset-0 rounded-full bg-slate-200 blur-sm opacity-50 group-hover:opacity-75 transition-opacity"></div>
                                    <img 
                                        src={wadir.foto} 
                                        alt={wadir.nama}
                                        onerror="this.onerror=null; this.src='/image/foto-dosen/default-avatar.svg';"
                                        class="relative w-full h-full object-cover rounded-full border-4 border-white shadow group-hover:scale-105 transition-transform duration-300" 
                                    />
                                </div>

                                <span class={`inline-block py-1 px-3.5 rounded-full text-xs font-bold uppercase tracking-wider ${wadir.badgeColor} mb-2 shadow-xs`}>
                                    {wadir.jabatan}
                                </span>

                                <h3 class="text-lg font-extrabold text-slate-900 group-hover:text-primary transition-colors mt-1">
                                    {wadir.nama}
                                </h3>

                                <div class="text-xs font-semibold text-slate-500 mt-1 mb-3">
                                    {wadir.bidang}
                                </div>

                                <p class="text-slate-600 text-xs leading-relaxed">
                                    {wadir.roleDesc}
                                </p>
                            </div>

                            <div class="mt-6 pt-4 border-t border-slate-100">
                                <a 
                                    href={`/dosen/${wadir.slug}`} 
                                    class="inline-flex items-center gap-1.5 text-xs font-bold text-slate-700 hover:text-primary uppercase tracking-wider group-hover:translate-x-1 transition-all"
                                >
                                    <span>Lihat Profil</span>
                                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                                </a>
                            </div>
                        </div>
                    ))}
                </div>
            </section>

            <!-- SECTION 2: HIERARKI HUBUNGAN ORGANISASI (Bagan Konseptual) -->
            <section class="mb-20 bg-white rounded-3xl p-8 md:p-12 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100">
                <div class="flex items-center gap-3 mb-8">
                    <div class="w-2.5 h-8 bg-blue-600 rounded-full"></div>
                    <div>
                        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Hirarki Tata Pamong & Koordinasi</h2>
                        <p class="text-sm text-slate-500 mt-0.5">Alur koordinasi institusional Politeknik Baja Tegal</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-4 gap-4 text-center">
                    <div class="p-5 rounded-2xl bg-blue-50/70 border border-blue-200">
                        <span class="text-xs font-bold uppercase tracking-wider text-blue-700">Tingkat 1</span>
                        <h4 class="font-bold text-slate-900 text-base mt-1">Direktorat</h4>
                        <p class="text-xs text-slate-600 mt-1">Pengambil kebijakan strategis dan kepemimpinan institusi.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-cyan-50/70 border border-cyan-200">
                        <span class="text-xs font-bold uppercase tracking-wider text-cyan-700">Tingkat 2</span>
                        <h4 class="font-bold text-slate-900 text-base mt-1">Wakil Direktur</h4>
                        <p class="text-xs text-slate-600 mt-1">Koordinasi bidang Akademik, Umum & Keuangan, serta Kemahasiswaan.</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-teal-50/70 border border-teal-200">
                        <span class="text-xs font-bold uppercase tracking-wider text-teal-700">Tingkat 3</span>
                        <h4 class="font-bold text-slate-900 text-base mt-1">Biro Administrasi</h4>
                        <p class="text-xs text-slate-600 mt-1">Layanan operasional BAAK (Akademik & Kemahasiswaan) dan BAUK (Umum & Keuangan).</p>
                    </div>
                    <div class="p-5 rounded-2xl bg-indigo-50/70 border border-indigo-200">
                        <span class="text-xs font-bold uppercase tracking-wider text-indigo-700">Tingkat 4</span>
                        <h4 class="font-bold text-slate-900 text-base mt-1">Program Studi & Lab</h4>
                        <p class="text-xs text-slate-600 mt-1">Pelaksana teknis pembelajaran vokasi 4 prodi serta laboratorium dan bengkel.</p>
                    </div>
                </div>

                <div class="mt-8 flex justify-center">
                    <a href="/biro" class="inline-flex items-center gap-2 px-5 py-3 rounded-2xl bg-slate-900 hover:bg-primary text-white font-semibold text-sm transition-colors shadow-md">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
                        <span>Pelajari Biro Administrasi (BAAK & BAUK)</span>
                    </a>
                </div>
            </section>

            <!-- SECTION 3: BAGAN STRUKTUR ORGANISASI RESMI (Gambar Asli) -->
            <section class="bg-white rounded-3xl p-8 md:p-12 shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100">
                <div class="flex items-center gap-3 mb-8">
                    <div class="w-2.5 h-8 bg-indigo-600 rounded-full"></div>
                    <div>
                        <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight">Bagan Struktur Organisasi Resmi</h2>
                        <p class="text-sm text-slate-500 mt-0.5">Dokumen resmi bagan susunan organisasi Politeknik Baja Tegal</p>
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
                    <!-- Diagram 1 -->
                    <div class="group bg-slate-50 rounded-2xl p-4 border border-slate-200 overflow-hidden">
                        <div class="relative overflow-hidden rounded-xl bg-white aspect-4/3 flex items-center justify-center border border-slate-100 shadow-xs">
                            <img 
                                src="/image/uploads/9027f960-9166-4bb2-8431-84a0dc947575-0-scaled.jpg" 
                                alt="Bagan Struktur Organisasi Politeknik Baja Tegal" 
                                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                                loading="lazy"
                            />
                        </div>
                        <div class="mt-4 flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-700">Bagan Struktur Organisasi 1</span>
                            <a 
                                href="/image/uploads/9027f960-9166-4bb2-8431-84a0dc947575-0-scaled.jpg" 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800"
                            >
                                <span>Buka Gambar Penuh</span>
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                            </a>
                        </div>
                    </div>

                    <!-- Diagram 2 -->
                    <div class="group bg-slate-50 rounded-2xl p-4 border border-slate-200 overflow-hidden">
                        <div class="relative overflow-hidden rounded-xl bg-white aspect-4/3 flex items-center justify-center border border-slate-100 shadow-xs">
                            <img 
                                src="/image/uploads/9027f960-9166-4bb2-8431-84a0dc947575-1-667x1024.jpg" 
                                alt="Bagan Alur Organisasi Politeknik Baja Tegal" 
                                class="w-full h-full object-contain group-hover:scale-105 transition-transform duration-500"
                                loading="lazy"
                            />
                        </div>
                        <div class="mt-4 flex items-center justify-between">
                            <span class="text-xs font-bold text-slate-700">Bagan Struktur Organisasi 2</span>
                            <a 
                                href="/image/uploads/9027f960-9166-4bb2-8431-84a0dc947575-1-667x1024.jpg" 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="inline-flex items-center gap-1 text-xs font-semibold text-blue-600 hover:text-blue-800"
                            >
                                <span>Buka Gambar Penuh</span>
                                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                            </a>
                        </div>
                    </div>
                </div>
            </section>

        </div>
    </main>
</MainLayout>
