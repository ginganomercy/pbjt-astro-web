---
import { getPosts } from '../../utils/api.js';
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
    // In Astro 4+, we fetch all possible routes at build time
    const posts = await getPosts(100); 
    return posts.map(post => ({
        params: { slug: post.slug },
        props: { post },
    }));
}

const { post } = Astro.props;
---

<MainLayout title={`${post.title.rendered} - Politeknik Baja Tegal`}>

    <main class="py-12 bg-white min-h-screen">
        <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <header class="mb-10 text-center">
                <p class="text-secondary-dark font-semibold uppercase tracking-widest text-sm mb-4">
                    {new Date(post.date).toLocaleDateString('id-ID', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' })}
                </p>
                <h1 class="text-4xl md:text-5xl font-extrabold text-slate-900 leading-tight mb-8" set:html={post.title.rendered} />
                
                {post._embedded?.['wp:featuredmedia'] && (
                    <div class="rounded-2xl overflow-hidden shadow-2xl shadow-primary/10 border border-slate-100 mb-12">
                        <img 
                            src={post._embedded['wp:featuredmedia'][0].source_url} 
                            alt={post.title.rendered}
                            class="w-full h-auto object-cover"
                        />
                    </div>
                )}
            </header>

            <div class="prose prose-lg prose-slate prose-a:text-primary hover:prose-a:text-primary-dark prose-headings:text-slate-800 mx-auto" set:html={post.content.rendered} />
            
        </article>
    </main>

</MainLayout>
