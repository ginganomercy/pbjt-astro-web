---
import MainLayout from '../../layouts/MainLayout.astro';
import fs from 'node:fs';
import path from 'node:path';

export async function getStaticPaths() {
    const prodis = [
        'd3-teknik-informatika',
        'd3-teknik-mesin',
        'd3-teknik-otomotif',
        'd3-teknik-elektronika-industri'
    ];
    
    const dokumens = ['rps', 'modul'];
    
    let paths = [];
    prodis.forEach(prodi => {
        dokumens.forEach(dok => {
            paths.push({ params: { prodi, dokumen: dok } });
        });
    });
    return paths;
}

const { prodi, dokumen } = Astro.params;

// Format judul
const formatProdiName = (str) => {
    return str.split('-')
              .map(word => word === 'd3' ? 'D3' : word.charAt(0).toUpperCase() + word.slice(1))
              .join(' ');
};

const prodiName = formatProdiName(prodi);
const docTitle = dokumen === 'rps' ? 'Rencana Pembelajaran Semester (RPS)' : 'Modul Pembelajaran Praktikum';
const fullTitle = `${docTitle} - ${prodiName}`;

// Pembacaan Folder Publik
const baseDir = path.join(process.cwd(), 'public', 'dokumen', prodi, dokumen);

let fileStructure = {};
let fileList = [];
let isEmpty = true;

// Helper format title
const formatFileName = (str) => {
    return str.replace(/-/g, ' ').replace(/\.pdf$/i, '').toUpperCase();
};

if (fs.existsSync(baseDir)) {
    const items = fs.readdirSync(baseDir);
    if (items.length > 0) {
        isEmpty = false;
        
        if (dokumen === 'rps') {
            const terms = ['ganjil', 'genap'];
            terms.forEach(term => {
                const termDir = path.join(baseDir, term);
                if (fs.existsSync(termDir)) {
                    fileStructure[term] = {};
                    const semesters = fs.readdirSync(termDir).filter(f => fs.statSync(path.join(termDir, f)).isDirectory());
                    semesters.sort((a, b) => a.localeCompare(b, undefined, {numeric: true, sensitivity: 'base'}));
                    
                    semesters.forEach(sem => {
                        const semDir = path.join(termDir, sem);
                        const files = fs.readdirSync(semDir).filter(f => f.endsWith('.pdf'));
                        if(files.length > 0) {
                            fileStructure[term][sem] = files.map(f => ({
                                name: formatFileName(f),
                                url: encodeURI(`/dokumen/${prodi}/rps/${term}/${sem}/${f}`)
                            }));
                        }
                    });
                }
            });
        } else if (dokumen === 'modul') {
            const files = items.filter(f => f.endsWith('.pdf'));
            fileList = files.map(f => ({
                name: formatFileName(f),
                url: encodeURI(`/dokumen/${prodi}/modul/${f}`)
            }));
        }
    }
}
---

<MainLayout title={fullTitle}>
    <main class="bg-slate-50 min-h-screen py-10 md:py-16">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Breadcrumbs -->
            <nav class="flex text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/" class="hover:text-blue-600 transition-colors">Beranda</a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-slate-400 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            <span class="text-slate-500">Akademik</span>
                        </div>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-slate-400 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            <a href={`/${prodi}`} class="hover:text-blue-600 transition-colors">{prodiName}</a>
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-slate-400 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            <span class="text-slate-800 font-semibold">{dokumen.toUpperCase()}</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <!-- Document Header -->
            <div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-slate-200 mb-10 flex flex-col md:flex-row md:items-end justify-between gap-6 relative overflow-hidden group">
                <div class="absolute -top-24 -right-24 w-64 h-64 bg-blue-50 rounded-full blur-[60px] pointer-events-none group-hover:bg-blue-100 transition-colors duration-700"></div>
                <div class="relative z-10">
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 text-blue-600 text-sm font-semibold mb-4 border border-blue-100">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                        E-Document
                    </div>
                    <h1 class="text-3xl md:text-5xl font-extrabold text-slate-900 tracking-tight mb-2">{docTitle}</h1>
                    <p class="text-lg text-slate-500 font-medium">{prodiName}</p>
                </div>
            </div>

            <!-- Content Area -->
            {isEmpty ? (
                /* Empty State */
                <div class="bg-white rounded-3xl p-12 text-center shadow-sm border border-slate-100 flex flex-col items-center justify-center py-24">
                    <div class="w-24 h-24 bg-slate-50 rounded-full flex items-center justify-center mb-6 border border-slate-100 shadow-sm">
                        <svg class="w-12 h-12 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 13h6m-3-3v6m5 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                    </div>
                    <h3 class="text-2xl font-bold text-slate-800 mb-2">Dokumen Belum Tersedia</h3>
                    <p class="text-slate-500 max-w-md mx-auto">File PDF untuk {docTitle} {prodiName} saat ini sedang dalam proses penyusunan oleh tim akademik. Harap kembali lagi nanti.</p>
                </div>
            ) : (
                /* Content Render */
                dokumen === 'rps' ? (
                    <div class="space-y-12">
                        {['ganjil', 'genap'].map(term => (
                            fileStructure[term] && Object.keys(fileStructure[term]).length > 0 && (
                                <section>
                                    <h2 class="text-2xl font-bold text-slate-800 mb-6 flex items-center gap-3">
                                        <span class="w-2 h-8 bg-gradient-to-b from-blue-500 to-indigo-600 rounded-full"></span>
                                        Semester {term.charAt(0).toUpperCase() + term.slice(1)}
                                    </h2>
                                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                                        {Object.keys(fileStructure[term]).map(sem => (
                                            <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
                                                <div class="bg-slate-50 border-b border-slate-100 p-4 px-6">
                                                    <h3 class="font-bold text-slate-800 capitalize flex items-center justify-between">
                                                        {sem.replace('-', ' ')}
                                                        <span class="text-xs font-semibold bg-blue-100 text-blue-700 px-2.5 py-1 rounded-full">
                                                            {fileStructure[term][sem].length} File
                                                        </span>
                                                    </h3>
                                                </div>
                                                <ul class="divide-y divide-slate-100 p-2 flex-1">
                                                    {fileStructure[term][sem].map(file => (
                                                        <li>
                                                            <a href={file.url} target="_blank" class="flex items-center gap-4 p-4 hover:bg-slate-50 rounded-2xl transition-colors group">
                                                                <div class="w-10 h-10 bg-red-50 text-red-500 rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-red-500 group-hover:text-white transition-colors">
                                                                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                                                                </div>
                                                                <span class="text-sm font-semibold text-slate-700 group-hover:text-blue-600 transition-colors line-clamp-2">
                                                                    {file.name}
                                                                </span>
                                                            </a>
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        ))}
                                    </div>
                                </section>
                            )
                        ))}
                    </div>
                ) : (
                    /* Modul Layout (Grid) */
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">
                        {fileList.map(file => (
                            <a href={file.url} target="_blank" class="bg-white p-6 rounded-3xl border border-slate-200 shadow-sm hover:shadow-xl hover:-translate-y-1 transition-all duration-300 group flex flex-col h-full relative overflow-hidden">
                                <div class="absolute top-0 right-0 w-24 h-24 bg-blue-50 rounded-full blur-[40px] opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none"></div>
                                <div class="w-14 h-14 bg-red-50 text-red-500 rounded-2xl flex items-center justify-center mb-5 group-hover:scale-110 group-hover:bg-red-500 group-hover:text-white transition-all duration-300 relative z-10">
                                    <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                                </div>
                                <h3 class="font-bold text-slate-800 mb-2 group-hover:text-blue-600 transition-colors line-clamp-3 relative z-10">{file.name}</h3>
                                <div class="mt-auto pt-4 flex items-center justify-between text-sm font-medium text-slate-400 relative z-10">
                                    <span class="group-hover:text-blue-600 transition-colors flex items-center gap-1">
                                        Buka Dokumen
                                        <svg class="w-4 h-4 opacity-0 -translate-x-2 group-hover:opacity-100 group-hover:translate-x-0 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                )
            )}

        </div>
    </main>
</MainLayout>
