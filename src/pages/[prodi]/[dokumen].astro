---
import MainLayout from '../../layouts/MainLayout.astro';

export async function getStaticPaths() {
    const prodis = [
        'd3-teknik-informatika',
        'd3-teknik-mesin',
        'd3-teknik-otomotif',
        'd3-teknik-elektronika-industri'
    ];
    
    const dokumens = ['rps', 'modul'];
    
    let paths = [];
    prodis.forEach(prodi => {
        dokumens.forEach(dok => {
            paths.push({ params: { prodi, dokumen: dok } });
        });
    });
    return paths;
}

const { prodi, dokumen } = Astro.params;

// Format judul agar rapi, contoh: "d3-teknik-informatika" -> "D3 Teknik Informatika"
const formatProdiName = (str) => {
    return str.split('-')
              .map(word => word === 'd3' ? 'D3' : word.charAt(0).toUpperCase() + word.slice(1))
              .join(' ');
};

const prodiName = formatProdiName(prodi);
const docTitle = dokumen === 'rps' ? 'Rencana Pembelajaran Semester (RPS)' : 'Modul Pembelajaran Praktikum';
const fullTitle = `${docTitle} - ${prodiName}`;
---

<MainLayout title={fullTitle}>
    <main class="bg-slate-50 min-h-screen py-10 md:py-16">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <!-- Breadcrumbs -->
            <nav class="flex text-sm text-slate-500 mb-8" aria-label="Breadcrumb">
                <ol class="inline-flex items-center space-x-1 md:space-x-3">
                    <li class="inline-flex items-center">
                        <a href="/" class="hover:text-blue-600 transition-colors">Beranda</a>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-slate-400 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            <span class="hover:text-blue-600 cursor-pointer">Akademik</span>
                        </div>
                    </li>
                    <li>
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-slate-400 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            <a href={`/${prodi}`} class="hover:text-blue-600 transition-colors">{prodiName}</a>
                        </div>
                    </li>
                    <li aria-current="page">
                        <div class="flex items-center">
                            <svg class="w-4 h-4 text-slate-400 mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                            <span class="text-slate-700 font-semibold">{dokumen.toUpperCase()}</span>
                        </div>
                    </li>
                </ol>
            </nav>

            <!-- Document Header -->
            <div class="bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-slate-200 mb-8 flex flex-col md:flex-row md:items-end justify-between gap-6">
                <div>
                    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 text-blue-600 text-sm font-semibold mb-4 border border-blue-100">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path></svg>
                        Dokumen Akademik
                    </div>
                    <h1 class="text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight mb-2">{docTitle}</h1>
                    <p class="text-lg text-slate-500">{prodiName}</p>
                </div>
                
                <div class="flex items-center gap-3">
                    <!-- Tombol Dummy Unduh -->
                    <button class="px-6 py-3 bg-slate-100 text-slate-400 font-bold rounded-xl cursor-not-allowed flex items-center gap-2">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path></svg>
                        Unduh PDF
                    </button>
                </div>
            </div>

            <!-- PDF Viewer Skeleton -->
            <div class="bg-slate-900 rounded-3xl shadow-2xl overflow-hidden border border-slate-800 relative w-full h-[600px] md:h-[800px] flex flex-col">
                <!-- Mac-like Toolbar -->
                <div class="h-12 bg-slate-800 border-b border-slate-700 flex items-center justify-between px-4 w-full">
                    <div class="flex gap-2">
                        <div class="w-3 h-3 rounded-full bg-slate-600"></div>
                        <div class="w-3 h-3 rounded-full bg-slate-600"></div>
                        <div class="w-3 h-3 rounded-full bg-slate-600"></div>
                    </div>
                    <div class="text-slate-400 text-sm font-mono bg-slate-900 px-4 py-1 rounded-md border border-slate-700">
                        {dokumen}-{prodi}.pdf
                    </div>
                    <div class="flex gap-3 text-slate-500">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM10 7v3m0 0v3m0-3h3m-3 0H7"></path></svg>
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0zM13 10H7"></path></svg>
                    </div>
                </div>

                <!-- Canvas Area (Loading State) -->
                <div class="flex-1 bg-slate-100 flex items-center justify-center relative overflow-hidden">
                    <!-- Decorative Background Grids -->
                    <div class="absolute inset-0" style="background-image: radial-gradient(#cbd5e1 1px, transparent 1px); background-size: 20px 20px;"></div>
                    
                    <!-- Paper Mockup -->
                    <div class="bg-white w-[90%] md:w-[70%] max-w-3xl h-[90%] shadow-2xl border border-slate-200 relative flex flex-col items-center justify-center p-8 text-center animate-pulse">
                        
                        <div class="w-20 h-20 bg-blue-50 rounded-full flex items-center justify-center mb-6">
                            <svg class="w-10 h-10 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                        
                        <h3 class="text-2xl font-bold text-slate-800 mb-2">Dokumen Belum Tersedia</h3>
                        <p class="text-slate-500 max-w-md mx-auto">
                            File PDF untuk <strong>{docTitle} {prodiName}</strong> saat ini sedang disiapkan oleh tim akademik. 
                            <br><br>
                            <em>(Kerangka Viewer ini sudah siap digunakan saat file asli diunggah nanti)</em>
                        </p>
                        
                    </div>
                </div>
            </div>

        </div>
    </main>
</MainLayout>
