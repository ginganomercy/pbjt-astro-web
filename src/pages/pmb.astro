---
import MainLayout from '../layouts/MainLayout.astro';
---

<MainLayout title="Penerimaan Mahasiswa Baru - Politeknik Baja Tegal">
    <main class="bg-slate-50 min-h-screen py-16">
        <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
            
            <header class="text-center mb-12">
                <h1 class="text-4xl md:text-5xl font-extrabold text-blue-900 mb-4 tracking-tight">Penerimaan Mahasiswa Baru</h1>
                <p class="text-xl text-slate-500">Tahun Akademik 2025/2026</p>
            </header>

            <!-- Skeleton Loader -->
            <div id="pmb-skeleton" class="w-full max-w-3xl mx-auto h-[600px] bg-slate-200 rounded-3xl animate-pulse shadow-sm border border-slate-100"></div>

            <!-- Kontainer Poster -->
            <div id="pmb-container" class="hidden max-w-4xl mx-auto bg-white p-4 md:p-8 rounded-[2.5rem] shadow-[0_8px_30px_rgb(0,0,0,0.04)] border border-slate-100 flex flex-col items-center">
                <div id="pmb-content" class="w-full flex justify-center">
                    <!-- Image will be injected here -->
                </div>
                
                <div class="mt-12 w-full max-w-lg mx-auto flex flex-col gap-4">
                    <a href="/alur-pendaftaran" class="w-full py-4 bg-gradient-to-r from-blue-600 to-blue-500 text-white font-bold text-center rounded-xl shadow-lg shadow-blue-500/30 hover:shadow-blue-500/50 hover:-translate-y-1 transition-all duration-300 text-lg flex items-center justify-center gap-2">
                        <span>Lihat Alur Pendaftaran</span>
                        <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                    </a>
                    <a href="/biaya-perkuliahan" class="w-full py-4 bg-white text-blue-600 font-bold text-center rounded-xl border-2 border-blue-100 hover:bg-blue-50 transition-all duration-300 text-lg">
                        Cek Biaya Perkuliahan
                    </a>
                </div>
            </div>

            <!-- Error State -->
            <div id="pmb-error" class="hidden text-center py-20 bg-red-50 rounded-3xl border border-red-100">
                <h3 class="text-2xl font-bold text-red-500 mb-2">Gagal Memuat Informasi</h3>
                <p class="text-slate-600">Pastikan koneksi internet stabil atau API tidak terblokir.</p>
            </div>

        </div>
    </main>

    <script>
        document.addEventListener('DOMContentLoaded', async () => {
            const skeleton = document.getElementById('pmb-skeleton');
            const container = document.getElementById('pmb-container');
            const content = document.getElementById('pmb-content');
            const errorEl = document.getElementById('pmb-error');

            try {
                const response = await fetch('https://wp.pbjt.ac.id/wp-json/wp/v2/pages?_embed&slug=pmb');
                if (!response.ok) throw new Error('API Error');
                
                const pages = await response.json();
                if (pages.length === 0) throw new Error('Page not found');
                
                const page = pages[0];
                let rawHtml = page.content.rendered;
                
                // Cari tag img
                const tempDiv = document.createElement('div');
                tempDiv.innerHTML = rawHtml;
                const img = tempDiv.querySelector('img');
                
                if (img) {
                    // Bersihkan dari srcset & sizes agar browser ambil ukuran paling besar
                    img.removeAttribute('srcset');
                    img.removeAttribute('sizes');
                    // Bersihkan dimensi thumbnail WordPress (-819x1024 dll) jika ada di atribut src
                    img.src = img.src.replace(/-\d+x\d+(?=\.(jpg|jpeg|png|webp|gif))/gi, '');
                    
                    // Styling
                    img.className = 'w-full h-auto max-h-[800px] object-contain rounded-2xl drop-shadow-md hover:scale-[1.02] transition-transform duration-500 cursor-pointer';
                    
                    content.appendChild(img);
                } else {
                    content.innerHTML = '<p class="text-slate-500 text-center py-10">Brosur PMB belum diunggah.</p>';
                }

                skeleton.classList.add('hidden');
                container.classList.remove('hidden');
                container.classList.add('animate-[fadeIn_0.5s_ease-out_forwards]');

            } catch (e) {
                console.error(e);
                skeleton.classList.add('hidden');
                errorEl.classList.remove('hidden');
            }
        });
    </script>
    <style>
        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(15px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</MainLayout>
